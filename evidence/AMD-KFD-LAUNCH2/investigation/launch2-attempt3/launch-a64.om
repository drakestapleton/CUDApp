ret ulong n
end
fn argfile i ulong flags int to int
n = patharg i
ret int checked fopen pathbuf 0 n flags 384
end
fn filesize fd int to ulong
n = checked fseek fd 0 2
r = checked fseek fd 0 0
ret ulong n
end
fn zerohdr to void
for i ulong 88
put hdr i 0
end
end
fn hput off ulong width ulong v ulong to void
for i ulong width
put hdr add off i uchar and shr v mul i 8 255
end
end
fn hget off ulong width ulong to ulong
v = ulong 0
for i ulong width
