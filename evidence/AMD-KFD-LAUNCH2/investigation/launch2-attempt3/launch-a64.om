p = ulong 20
while gt v 9 bound 20
p = sub p 1
put b p uchar add rem v 10 48
v = div v 10
end
p = sub p 1
put b p uchar add v 48
emit part b p sub 20 p
end
fn roundup n ulong a ulong to ulong
