fd = argfile add i 7 0
size = filesize fd
if eq size 0
exit 64
end
h = allocate add i 8 size 0xa0000001
filecopy fd 0 h 0 size
r = checked fclose fd
end
filecopy int get config 0 get config 2 lh 1 0 get el 8
for i ulong get config 1 bound 9223372036854775807
p = add 48 mul i 16
off = fword int get config 0 p 8
idx = fword int get config 0 add p 8 8
h = lh 2
if lt idx get launch 1
h = lh add idx 8
end
r = checked mapset lh 1 off 8 mapaddr h
end
r = checked fclose int get config 0
end
fn vaddinputs to void
if ne get el 8 28
exit 65
end
h = allocate 8 1024 0xa0000001
h = allocate 9 1024 0xa0000001
note IEEE754 binary32 1 + 1 = 2; exact independent host oracle in the gate.
for i ulong 256
r = checked mapset lh 8 mul i 4 4 0x3f800000
r = checked mapset lh 9 mul i 4 4 0x3f800000
r = checked mapset lh 2 mul i 4 4 0x7fc00000
end
r = checked mapset lh 1 0 8 mapaddr lh 8
r = checked mapset lh 1 8 8 mapaddr lh 9
r = checked mapset lh 1 16 8 mapaddr lh 2
r = checked mapset lh 1 24 4 256
end
fn vaddcheck to void
for i ulong 256
if ne mapget lh 2 mul i 4 4 0x40000000
steprow 5 false
exit 76
end
end
emit passed
end
fn main to int
if lt argcnt 4
ret 64
end
isinspect = mode inspectmode
isvadd = mode vaddmode
isrun = mode runmode
if not or isinspect or isvadd isrun
ret 64
end
parseelf 2 3
if isinspect
emit parsed
printnum get el 7
emit argslabel
printnum get el 8
emit newline
r = checked fclose int get el 0
ret 0
end
if isvadd
if ne argcnt 4
ret 64
end
put launch 1 2
put launch 2 1
put launch 3 10000000000
put launch 4 1024
put launch 5 4
put launch 6 1
else
if lt argcnt 8
ret 64
end
put launch 1 sub ulong argcnt 8
put launch 5 argnum 4
put launch 6 argnum 5
if or eq get launch 5 0 gt get launch 5 div ulong 4294967295 64
ret 64
end
if or eq get launch 6 0 gt get launch 6 4294967295
ret 64
end
configread
end
connectkfd
prepare
if isvadd
vaddinputs
else
loadinputs
end
queueinit
dispatch
stepbegin streadback get launch 4
if isvadd
vaddcheck
else
fd = argfile sub ulong argcnt 1 577
savefile fd lh 2 get launch 4
r = checked fclose fd
end
stepend
teardown
ret 0
end
note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note Shared CLI unsigned parser; append after aql.om, kernarg.om, records.om or ring.om.
note A uint64 text needs at most 20 decimal digits or 0x plus 16 hexadecimal digits.
note Buffer 21 permits the extra byte that makes an overlong value refuse, not truncate.
note WolframLanguageEvaluator: {2^64-1,Quotient[2^64-1,10],Mod[2^64-1,10]} ->
note {18446744073709551615,1844674407370955161,5} (integer range, dimensionless).
fn argnum i ulong to ulong
ab = new uchar 21 0
n = argread i ab 0 21
if lt n 1
exit 2
end
k = ulong n
s = ulong 0
hex = false
if gt k 2
if and eq get ab 0 48 eq get ab 1 120
hex = true
s = ulong 2
end
end
m = sub k s
if hex
if gt m 16
exit 2
end
end
v = ulong 0
for j ulong m
d = ulong get ab add j s
dv = ulong 16
if and ge d 48 le d 57
dv = sub d 48
end
if hex
if and ge d 97 le d 102
dv = sub d 87
end
if eq dv 16
exit 2
end
v = or shl v 4 dv
else
if gt dv 9
exit 2
end
if gt v 1844674407370955161
exit 2
end
if and eq v 1844674407370955161 gt dv 5
exit 2
end
v = add mul v 10 dv
end
end
ret v
end
note Full write or exit 74. Applies to files and pipes, including partial writes and EINTR.
fn emit b view uchar * to void
p = ulong 0
while lt p len b bound 999999
r = write 1 b p sub len b p
if eq r neg long 4
continue
end
if le r 0
exit 74
end
p = add p ulong r
end
end
