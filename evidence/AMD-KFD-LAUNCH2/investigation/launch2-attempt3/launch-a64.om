fn steprow err ulong before bool to void
r = write 1 stepprefix 0 len stepprefix
r = write 1 stepname 0 get stepstate 0
if eq err 0
r = write 1 stepok 0 len stepok
else
r = write 1 stepfail 0 len stepfail
printnum err
end
if before
r = write 1 stepbefore 0 len stepbefore
else
r = write 1 stepafter 0 len stepafter
end
printnum get stepstate 1
r = write 1 newline 0 len newline
end
fn stepbegin name view uchar * detail ulong to void
for i ulong len name bound 64
put stepname i get name i
end
put stepstate 0 len name
put stepstate 1 detail
steprow 0 true
end
fn stepend to void
steprow 0 false
end
fn stepresult r long to long
if lt r 0
steprow ulong neg r false
else
stepend
end
ret r
end
fn checked r long to long
if lt r 0
steprow ulong neg r false
emit failed
if eq r -9223372036854775808
exit 74
end
printnum ulong neg r
emit newline
exit 74
end
ret r
end
fn printnum v ulong to void
