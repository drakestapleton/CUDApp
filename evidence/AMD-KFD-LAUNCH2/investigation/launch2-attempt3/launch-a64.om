fn zeromap dst long off ulong n ulong to void
for i ulong len chunk bound 4096
put chunk i 0
end
p = ulong 0
while lt p n bound 9223372036854775807
k = sub n p
if gt k len chunk
k = len chunk
end
r = checked mapwrite dst add off p chunk 0 k
p = add p k
end
end
fn savefile fd int src long n ulong to void
p = ulong 0
while lt p n bound 9223372036854775807
k = sub n p
if gt k len chunk
k = len chunk
end
r = checked mapread src p chunk 0 k
