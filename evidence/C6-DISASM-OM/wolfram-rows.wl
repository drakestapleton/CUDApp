pack[s_String] := FromDigits[Reverse[#], 256] & /@ Partition[ToCharacterCode[s, "ASCII"], UpTo[8]];
hex[h_] := FromDigits[h, 16];
ops = DeleteDuplicates[Mod[hex[#[[1]]], 4096] & /@ rows];
grp = Table[Select[rows, Mod[hex[#[[1]]], 4096] == op &], {op, ops}];
blk[op_, rs_] := Module[{lines = {}, k = 0},
  AppendTo[lines, "if eq op " <> ToString[op]];
  Do[With[{b = 10 k, ch = pack[r[[3]]]},
     AppendTo[lines, "note " <> r[[3]]];
     AppendTo[lines, "put t " <> ToString[b] <> " " <> ToString[hex[r[[1]]]]];
     If[hex[r[[2]]] != 0, AppendTo[lines, "put t " <> ToString[b + 1] <> " " <> ToString[hex[r[[2]]]]]];
     Do[AppendTo[lines, "put t " <> ToString[b + 1 + j] <> " " <> ToString[ch[[j]]]], {j, Length[ch]}];
     k++], {r, rs}];
  AppendTo[lines, "ret " <> ToString[k]]; AppendTo[lines, "end"]; lines];
parts = Partition[Range[Length[ops]], UpTo[Ceiling[Length[ops]/3]]];
names = {"rowsa", "rowsb", "rowsc"};
out = Flatten[Table[{"fn " <> names[[p]] <> " op ulong t edit ulong 80 to ulong",
     Flatten[blk[ops[[#]], grp[[#]]] & /@ parts[[p]]], "ret 0", "end", ""}, {p, Length[parts]}]];
{Length[rows], Length[ops], Max[Length /@ grp], Max[StringLength[#[[3]]] & /@ rows], Length[out], Hash[StringRiffle[out, "\n"], "SHA256", "HexString"]}
