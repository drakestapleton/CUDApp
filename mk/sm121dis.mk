# C6 of docs/OMEGA.md: Omega's own sm_121 disassembler (om/disasm/sm121_dis.om through the generated binding
# src/cudapp_om_sm121_dis.c, glue in src/omega_sm121_disasm.c; tools/sm121dis/). CUDA++ C6, DRA-475.
#   make test-sm121dis   collect every kernel the library builds (no GPU), compare our text with nvdisasm's, word by word;
#                        then the red check: a decoder built with one deliberate fault must FAIL the same comparison;
#                        then the differential: the .om decoder and the migration-pending C decoder on every word of
#                        the corpus (abort on any difference), with its red check; then the flipped-bit control.
#   make test-sm121dis-om-mutants   three one-line mutants of the .om decoder, each regenerated by the pinned omc and
#                        bridge (om/units.sh), must each change the text of the corpus (needs OMEGA_OMC, OMEGA_BRIDGE).
# Picked up by the `-include mk/*.mk` line of the Makefile. The test binaries are named as files, not through the
# GPU_*_TEST variables: this file is read before the Makefile defines them.
SM121DIS = $(OUT_DIR)/sm121dis
SM121DIS_RED = $(OUT_DIR)/sm121dis_red
SM121DIS_DIFF = $(OUT_DIR)/sm121dis_diff
SM121DIS_DIFF_RED = $(OUT_DIR)/sm121dis_diff_red
SM121DIS_K = $(OUT_DIR)/sm121dis-kernels
SM121DIS_DEPS = tools/sm121dis/sm121dis.c src/omega_sm121_disasm.c src/omega_sm121_disasm.h src/cudapp_om_sm121_dis.c \
	src/cudapp_native.h src/omega_dis_words.h src/cudapp_om_words.c
# the command line reads each word through the seeded word unit (om/disasm/words.om, src/omega_dis_words.h)
SM121DIS_SRCS = tools/sm121dis/sm121dis.c src/omega_sm121_disasm.c src/cudapp_om_sm121_dis.c src/cudapp_om_words.c
SM121DIS_CC = $(CC) -std=gnu11 -Wall -Wextra -Werror -O2 -Isrc

$(SM121DIS): $(SM121DIS_DEPS)
	@mkdir -p $(OUT_DIR)
	$(SM121DIS_CC) $(CUDAPP_DISASM_DEFS) -o $@ $(SM121DIS_SRCS)
# the red decoder: the C oracle with one planted fault (first source register off by one bit)
$(SM121DIS_RED): $(SM121DIS_DEPS)
	@mkdir -p $(OUT_DIR)
	$(SM121DIS_CC) -DCUDAPP_MIGRATION_PENDING_C_DISASM -DSM121DIS_MUTANT=1 -o $@ tools/sm121dis/sm121dis.c src/omega_sm121_disasm.c src/cudapp_om_words.c
$(SM121DIS_DIFF): $(SM121DIS_DEPS)
	@mkdir -p $(OUT_DIR)
	$(SM121DIS_CC) -DCUDAPP_MIGRATION_PENDING_DISASM_DIFF -o $@ $(SM121DIS_SRCS)
$(SM121DIS_DIFF_RED): $(SM121DIS_DEPS)
	@mkdir -p $(OUT_DIR)
	$(SM121DIS_CC) -DCUDAPP_MIGRATION_PENDING_DISASM_DIFF -DCUDAPP_DISASM_DIFF_SELFTEST -o $@ $(SM121DIS_SRCS)

sm121dis-corpus-bins: $(addprefix $(OUT_DIR)/,gpu_matmul_api_test gpu_elementwise_test gpu_reconv_test gpu_attention_test \
	gpu_moe_window_test gpu_fp8_api_test gpu_decode_attn_test gpu_router_test gpu_bf16_gemv_test gpu_fp8gemm_test \
	gpu_tc_probe_test gpu_tc_peak_test gpu_pf_mem_test gpu_qmma_probe_test gpu_cmdlist_test gpu_decode_graph_test gpu_tcgemm_test \
	gpu_prefill_attn_test gpu_pfgemm_test gpu_qgemm_test gpu_pfhost_test gpu_gpr_boundary_test \
	gpu_scan_test gpu_gemm_test gpu_streams_test gpu_isolation_test bw_hazard_test gpu_mathlibs_test)

.PHONY: test-sm121dis sm121dis-corpus-bins test-sm121dis-corpus-controls test-sm121dis-check-controls
test-sm121dis-corpus-controls:
	sh tools/sm121dis/corpus_selftest.sh

test-sm121dis-check-controls:
	sh tools/sm121dis/check_selftest.sh

test-sm121dis: $(SM121DIS) $(SM121DIS_RED) $(SM121DIS_DIFF) $(SM121DIS_DIFF_RED) sm121dis-corpus-bins test-sm121dis-corpus-controls test-sm121dis-check-controls
	rm -rf $(SM121DIS_K) && sh tools/sm121dis/corpus.sh $(OUT_DIR) $(SM121DIS_K)
	sh tools/sm121dis/check.sh $(SM121DIS) $(SM121DIS_K) $(OUT_DIR)/sm121dis-work
	@if sh tools/sm121dis/check.sh $(SM121DIS_RED) $(SM121DIS_K) $(OUT_DIR)/sm121dis-red > $(OUT_DIR)/sm121dis-red.log 2>&1; then \
		echo "RED CHECK BROKEN: the faulty decoder passed"; exit 1; \
	elif ! grep -q '^VERDICT FAIL' $(OUT_DIR)/sm121dis-red.log; then \
		echo "RED CHECK BROKEN: the faulty decoder's run did not reach a verdict"; tail -3 $(OUT_DIR)/sm121dis-red.log; exit 1; \
	else echo "red check: the faulty decoder FAILS the comparison, as it must ($$(grep -c '^\[FAIL\]' $(OUT_DIR)/sm121dis-red.log) kernels)"; fi
	@n=0; for f in $(SM121DIS_K)/*.bin; do n=$$((n+1)); rc=0; $(SM121DIS_DIFF) --pairs $$f > /dev/null 2> $(OUT_DIR)/sm121dis-diff.err || rc=$$?; \
		if [ $$rc != 0 ]; then echo "FAIL .om vs C decoder differential on $$f (exit $$rc)"; head -3 $(OUT_DIR)/sm121dis-diff.err; exit 1; fi; done; \
	echo "decoder differential: .om and migration-pending C decoders agree on every word of $$n kernels"
	@rc=0; (ulimit -c 0; $(SM121DIS_DIFF_RED) --pairs $$(ls $(SM121DIS_K)/*.bin | head -1) > /dev/null 2> $(OUT_DIR)/sm121dis-diff-red.err) || rc=$$?; \
	if [ $$rc -le 128 ] || ! grep -q '^DISASM DIFFER' $(OUT_DIR)/sm121dis-diff-red.err; then \
		echo "RED CHECK BROKEN: the differential did not abort on a flipped bit (exit $$rc)"; exit 1; fi; \
	echo "red check: one flipped bit aborts the decoder differential, as it must (exit $$rc)"
	sh tools/sm121dis/negctl.sh $(SM121DIS) $(SM121DIS_K) $(OUT_DIR)/sm121dis-work

.PHONY: test-sm121dis-om-mutants
test-sm121dis-om-mutants:
	@ls $(SM121DIS_K)/*.bin > /dev/null 2>&1 || { echo "NOT_RUN: no corpus in $(SM121DIS_K) (make test-sm121dis first)"; exit 2; }
	OMEGA_OMC="$(OMEGA_OMC)" OMEGA_BRIDGE="$(OMEGA_BRIDGE)" sh tools/sm121dis/om_mutants.sh $(OUT_DIR)/sm121dis-om-mutants $(SM121DIS_K)

# The device-trace emitter's words (tests/device-trace/run-emitter-checks.sh) decoded by our disassembler against the
# hand-written expectations, never nvdisasm here (NVDISASM is cleared); then the red check: the faulty decoder must FAIL.
.PHONY: test-device-trace-emitter
test-device-trace-emitter: $(SM121DIS) $(SM121DIS_RED)
	@test "$$(sha256sum < $(OMEGA_OMC) | cut -c1-64)" = 2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f || { echo "NOT_RUN: wrong seeded compiler $(OMEGA_OMC)"; exit 3; }
	NVDISASM= OMEGA_COMPILER="$(OMEGA_OMC)" SM121DIS=$(SM121DIS) sh tests/device-trace/run-emitter-checks.sh
	@rc=0; NVDISASM= OMEGA_COMPILER="$(OMEGA_OMC)" SM121DIS=$(SM121DIS_RED) sh tests/device-trace/run-emitter-checks.sh \
		> $(OUT_DIR)/device-trace-red.log 2>&1 || rc=$$?; \
	if [ $$rc != 1 ] || ! grep -q '^offset 0x.*: want' $(OUT_DIR)/device-trace-red.log; then \
		echo "RED CHECK BROKEN: the faulty decoder did not fail the expectations (exit $$rc)"; tail -3 $(OUT_DIR)/device-trace-red.log; exit 1; fi; \
	echo "red check: the faulty decoder FAILS the device-trace expectations, as it must ($$(grep -c '^offset 0x' $(OUT_DIR)/device-trace-red.log) lines)"

# The provenance checks (tools/divsqrt_nvdisasm_check.sh, tools/ldst_nvdisasm_check.sh, test-numeric-reduce-nvdisasm)
# call build/sm121dis by that name, whatever OUT_DIR is.
ifneq ($(OUT_DIR),build)
build/sm121dis: $(SM121DIS_DEPS)
	@mkdir -p build
	$(SM121DIS_CC) $(CUDAPP_DISASM_DEFS) -o $@ $(SM121DIS_SRCS)
endif

# ZERO-NVDISASM (bar C6, second half: nothing calls nvdisasm). tools/sm121dis/zero_nvdisasm.sh runs every listing and
# provenance check with a decoy nvdisasm first on PATH, the CUDA directories removed from PATH, and strace on execve;
# then its own red check plants two calls to nvdisasm and must see the gate FAIL.
.PHONY: test-zero-nvdisasm
test-zero-nvdisasm: $(SM121DIS) build/sm121dis $(addprefix $(OUT_DIR)/,gpu_attention_test gpu_elementwise_test gpu_fp8_api_test gpu_reconv_test bw_hazard_test)
	PHYSICS_DIR="$(PHYSICS_DIR)" sh tools/sm121dis/zero_nvdisasm.sh $(OUT_DIR)
	@if PHYSICS_DIR="$(PHYSICS_DIR)" sh tools/sm121dis/zero_nvdisasm.sh $(OUT_DIR) --red > $(OUT_DIR)/zero-nvdisasm-red.log 2>&1; then \
		echo "RED CHECK BROKEN: the planted nvdisasm calls passed the gate"; exit 1; \
	else echo "red check: the planted nvdisasm calls FAIL the gate, as they must ($$(grep -c 'FAIL$$' $(OUT_DIR)/zero-nvdisasm-red.log) lines)"; fi

# Issue #171: the semantic fixture and expectation live in Omega. NVIDIA's
# pinned offline decoder is read-only; neither output nor the mutant enters a kernel.
NVDISASM ?= /usr/local/cuda/bin/nvdisasm
SM121_MMIO = $(OUT_DIR)/sm121-mmio
$(SM121_MMIO): om/encoder/bw_enc_sm121.om om/encoder/mmio_test.om
	@mkdir -p $(OUT_DIR)
	@test "$$(sha256sum < $(OMEGA_MV)/seed/out/omc | cut -c1-64)" = 2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f || { echo "NOT_RUN: wrong seeded compiler"; exit 3; }
	cat $^ > $@.om
	$(OMEGA_MV)/seed/out/omc < $@.om > $@
	chmod +x $@

.PHONY: test-sm121-mmio
test-sm121-mmio: $(SM121_MMIO)
	@$(NVDISASM) --version > $(SM121_MMIO).version
	@case "$$(cat $(SM121_MMIO).version)" in *V13.0.85*) ;; *) echo "NOT_RUN: nvdisasm version must be 13.0.85"; exit 3;; esac
	@sha256sum $(NVDISASM)
	$(SM121_MMIO) > $(SM121_MMIO).bin
	$(NVDISASM) -b SM121 -hex $(SM121_MMIO).bin > $(SM121_MMIO).nv
	$(SM121_MMIO) check oracle < $(SM121_MMIO).nv
	$(SM121_MMIO) wrong-cache-policy > $(SM121_MMIO)-ef.bin
	$(NVDISASM) -b SM121 -hex $(SM121_MMIO)-ef.bin > $(SM121_MMIO)-ef.nv
	@if $(SM121_MMIO) check oracle < $(SM121_MMIO)-ef.nv; then \
		echo "FAIL: EF satisfied the MMIO.GPU contract"; exit 1; \
	else rc=$$?; test "$$rc" = 4 || exit "$$rc"; \
		echo "PASS: exact MMIO.GPU op and operands; wrong-EF negative refused. GB10 DEVICE NOT_RUN"; fi

# BlackwellIR ops 64..79 after the #280 numbering move (evidence/INTEG-280-20261110/numbering.txt):
# om/disasm/opmove_test.om, composed after the seeded encoder and this decoder and compiled by the pinned omc, encodes
# one row of each op; Omega's own decoder must know every word and print the op's mnemonic, and the nvdisasm 13.0.85
# ORACLE (offline, read-only, never shipped) must print the decoder's text for each word. Red checks: the rows
# numbered as before the move (stale numbering, exit 41), the decoder without its DADD row (exit 15), the oracle text
# without its DADD line (exit 4).
SM121DIS_OPMOVE = $(OUT_DIR)/sm121dis-opmove
SM121DIS_OPMOVE_RED = 's/^if eq op 553$$/if eq op 4096/'
.PHONY: test-sm121dis-opmove
test-sm121dis-opmove: om/encoder/bw_enc_sm121.om om/disasm/sm121_dis.om om/disasm/opmove_test.om
	@[ -x "$(OMEGA_OMC)" ] && [ "$$(sha256sum < $(OMEGA_OMC) | cut -c1-64)" = 2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f ] || { echo "NOT_RUN: set OMEGA_OMC to the pinned seeded compiler"; exit 3; }
	@case "$$($(NVDISASM) --version 2>/dev/null)" in *V13.0.85*) ;; *) echo "NOT_RUN: nvdisasm version must be 13.0.85"; exit 3;; esac
	@mkdir -p $(OUT_DIR)
	cat om/encoder/bw_enc_sm121.om om/disasm/sm121_dis.om om/disasm/opmove_test.om > $(SM121DIS_OPMOVE).om
	$(OMEGA_OMC) < $(SM121DIS_OPMOVE).om > $(SM121DIS_OPMOVE)
	chmod +x $(SM121DIS_OPMOVE)
	$(SM121DIS_OPMOVE)
	$(SM121DIS_OPMOVE) bin > $(SM121DIS_OPMOVE).bin
	$(NVDISASM) -b SM121 -hex $(SM121DIS_OPMOVE).bin > $(SM121DIS_OPMOVE).nv
	$(SM121DIS_OPMOVE) check oracle < $(SM121DIS_OPMOVE).nv
	@rc=0; $(SM121DIS_OPMOVE) stale numbering control || rc=$$?; \
	if [ $$rc != 41 ]; then echo "RED CHECK BROKEN: the stale numbering exited $$rc, not 41"; exit 1; fi; \
	echo "red check: the stale numbering (I2FP_U32 encoded as op 64) exits 41, as it must"
	@sed $(SM121DIS_OPMOVE_RED) om/disasm/sm121_dis.om > $(SM121DIS_OPMOVE)-red.dis.om; \
	if cmp -s $(SM121DIS_OPMOVE)-red.dis.om om/disasm/sm121_dis.om; then echo "RED CHECK BROKEN: the DADD row edit changed nothing"; exit 1; fi; \
	cat om/encoder/bw_enc_sm121.om $(SM121DIS_OPMOVE)-red.dis.om om/disasm/opmove_test.om | $(OMEGA_OMC) > $(SM121DIS_OPMOVE)-red || exit 1; \
	chmod +x $(SM121DIS_OPMOVE)-red; rc=0; $(SM121DIS_OPMOVE)-red || rc=$$?; \
	if [ $$rc != 15 ]; then echo "RED CHECK BROKEN: the decoder without its DADD row exited $$rc, not 15"; exit 1; fi; \
	echo "red check: the decoder without its DADD row exits 15, as it must"
	@rc=0; grep -v -- 'DADD' $(SM121DIS_OPMOVE).nv | $(SM121DIS_OPMOVE) check oracle || rc=$$?; \
	if [ $$rc != 4 ]; then echo "RED CHECK BROKEN: oracle text without the DADD line exited $$rc, not 4"; exit 1; fi; \
	echo "red check: oracle text without the DADD line exits 4, as it must"
	@echo "PASS BlackwellIR ops 64..79: 16 rows encoded, Omega's decoder knows all 16, nvdisasm 13.0.85 prints the same text. GB10 DEVICE NOT_RUN"
