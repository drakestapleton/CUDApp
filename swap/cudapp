#!/bin/bash
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# cudapp: swap NVIDIA's CUDA stack for CUDA++ and back, one command each way.
#
#   cudapp swap status            what is installed, what is loaded, what the loader finds, who holds the GPU
#   cudapp swap user   [--yes]    user space: programs load CUDA++'s libcuda.so.1 instead of NVIDIA's
#   cudapp swap kernel [--yes]    kernel: NVIDIA's modules held back, AIEN's aien_gpu driver loads (next boot)
#   cudapp swap all    [--yes]    both
#   cudapp swap back   [--yes]    NVIDIA's stack exactly as it was (every touched file checked by SHA-256)
#   cudapp run CMD...             one program on CUDA++'s libcuda.so.1, nothing on the system changed
#
# Without --yes every level is a dry run: it checks, prints what it would change, and changes nothing.
# Every file it changes is copied first into /var/lib/cudapp-swap/backup-<UTC>-<level>/ with a manifest of
# path, state and SHA-256; `back` copies them back and checks every hash. NVIDIA's own files are never edited or
# removed: the user level only adds a library directory the loader searches first, the kernel level only adds a
# hold-back file and our module. It never reboots unless --reboot is given.
#
# Exit codes: 0 done (or dry run printed), 1 failed (back: a hash did not match), 2 usage, 3 refused by a check.
# tests/swap/test_swap_cli.sh runs every level against a fake machine root.
#
# Sources: --lib PATH (CUDA++ libcuda.so.1), --driver-src PATH (aien_gpu source), --kdir PATH (kernel build dir).
# CUDAPP_LIB, CUDAPP_DRIVER_SRC and CUDAPP_KDIR are the defaults for a run that is not a delegated root build.
# Escalation runs `sudo "$0" swap ...` WITHOUT -E. A sudoers rule that names only this script rejects the
# caller's environment (BASH_ENV, SUDO_UID, CUDAPP_DRIVER_SRC, sudo -E); it still allows arguments. Those
# arguments must not choose the tree make runs as root. A delegated kernel swap (SUDO_UID set to a non-root
# user, or this script's own sudo re-entry) builds /usr/src/aien-gpu and /lib/modules/$(uname -r)/build.
# Both must be owned by root and not writable by group or other, and neither may carry an ACL. The module
# source must contain no symlink. /lib -> usr/lib and the kernel's build symlink are followed when the link
# is owned by root and the resolved directory stays under /lib/modules, /usr/lib/modules or /usr/src.
# make and cc are taken from a fixed PATH whose directories and resolved binaries are root-owned and
# not group/other-writable, so a caller cannot plant a compiler via PATH, CC or MAKEFLAGS.
# A root shell with SUDO_UID unset may still pass --driver-src and --kdir; a shell started by sudo keeps
# SUDO_UID, so unset it before a custom-source build. Do not grant SETENV on the sudoers rule.
set -u
DRIVER_SRC_ENV_SET=0; [ "${CUDAPP_DRIVER_SRC+x}" = x ] && DRIVER_SRC_ENV_SET=1
KDIR_ENV_SET=0; [ "${CUDAPP_KDIR+x}" = x ] && KDIR_ENV_SET=1
ROOT=${CUDAPP_ROOT:-}
STATE=$ROOT/var/lib/cudapp-swap
SELF=$(readlink -f "$0")
SELF_DIR=$(cd "$(dirname "$SELF")" && pwd)
REPO_DIR=$(cd "$SELF_DIR/.." && pwd -P)
LIB_SRC=${CUDAPP_LIB:-$SELF_DIR/../build/swap/libcuda.so.1}
DRIVER_SRC=${CUDAPP_DRIVER_SRC:-$HOME/workspace/aienos-own-gpu-driver/native/linux/aien-gpu}
KVER=$(uname -r)
KDIR=${CUDAPP_KDIR:-/lib/modules/$KVER/build}

OUR_LIBDIR=/usr/lib/cudapp
LDCONF=/etc/ld.so.conf.d/00000-cudapp-swap.conf   # sorts before every other entry in C and UTF-8 collation
LDCACHE=/etc/ld.so.cache
MODCONF=/etc/modprobe.d/cudapp-swap-kernel.conf
MODLOAD=/etc/modules-load.d/cudapp-aien-gpu.conf
MODDIR=/lib/modules/$KVER/updates/cudapp
INITRD=/boot/initrd.img-$KVER
NV_MODULES="nvidia nvidia_uvm nvidia_modeset nvidia_drm"

YES=0; REBOOT=0; HOLDERS_OK=0
DRIVER_SRC_OPTION=0; KDIR_OPTION=0
die()    { echo "cudapp: $*" >&2; exit 1; }
refuse() { echo "REFUSED: $*" >&2; exit 3; }
# A machine that schedules GPU work through spark-window (the invoking user has the tool) reboots only inside a window.
window_host() {
    command -v spark-window >/dev/null 2>&1 && return 0
    [ -n "${SUDO_USER:-}" ] || return 1
    local h; h=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    [ -n "$h" ] && [ -x "$h/.local/bin/spark-window" ]
}
usage()  { sed -n '3,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
sha()    { if [ -e "$1" ] || [ -L "$1" ]; then sha256sum < "$1" | cut -d' ' -f1; else echo -; fi; }
# sudo sets SUDO_UID itself. A sudoers rule without SETENV rejects `sudo SUDO_UID=...`; do not trust a
# value the caller could have kept only when SETENV is granted (that grant also allows BASH_ENV).
sudo_origin() { [ -n "${SUDO_UID:-}" ] && [ "$SUDO_UID" != 0 ]; }
caller_selected_build() {
    [ "$DRIVER_SRC_OPTION" -eq 1 ] || [ "$KDIR_OPTION" -eq 1 ] || \
        [ "$DRIVER_SRC_ENV_SET" -eq 1 ] || [ "$KDIR_ENV_SET" -eq 1 ]
}
delegated_build() {
    case $level in kernel|all) ;; *) return 1;; esac
    sudo_origin && { [ "$(id -u)" -eq 0 ] || [ -n "$ROOT" ]; }
}
# $1 path, $2 owner uid. A symlink's mode is ignored by the kernel, so only its owner is checked here.
# An ACL can grant write without setting the mode bits, and this helper has no getfacl. GNU ls prints '+'
# after the mode when an ACL is present ('.' is a security context and is left alone). Any ACL is refused.
path_owner_mode() {
    local p=$1 owner=$2 uid mode perm mark
    [ -e "$p" ] || [ -L "$p" ] || refuse "trusted path does not exist: $p"
    uid=$(stat -c %u "$p") || refuse "cannot stat $p"
    [ "$uid" = "$owner" ] || refuse "trusted path is not owned by uid $owner: $p"
    if [ -L "$p" ]; then return 0; fi
    mode=$(stat -c %a "$p") || refuse "cannot stat $p"
    perm=$((8#$mode & 8#022))
    [ "$perm" -eq 0 ] || refuse "trusted path is writable by group or other: $p"
    mark=$(ls -ld "$p" | awk '{print $1}') || refuse "cannot list $p"
    case $mark in ??????????+*) refuse "trusted path has an ACL: $p";; esac
}
# Collapse "." and ".." without following symlinks.
normalize() {
    local in=$1 part out=
    case $in in /*) ;; *) in=/$in;; esac
    while [ "$in" != / ] && [ -n "$in" ]; do
        in=${in#/}
        part=${in%%/*}
        if [ "$part" = "$in" ]; then in=; else in=${in#*/}; fi
        case $part in
            ''|.) ;;
            ..) [ -n "$out" ] && out=${out%/*};;
            *) out=$out/$part;;
        esac
    done
    [ -n "$out" ] || out=/
    printf '%s\n' "$out"
}
# Walk $1 up through $2 inclusive. No component may be a symlink.
walk_owned() {
    local p=$1 stop=$2 owner=$3
    while :; do
        [ ! -L "$p" ] || refuse "trusted path contains a symlink: $p"
        path_owner_mode "$p" "$owner"
        [ "$p" = "$stop" ] && break
        [ "$p" = / ] && break
        p=${p%/*}; [ -n "$p" ] || p=/
    done
}
apply_delegated_sources() {
    local owner stop src kd target shown
    if sudo_origin && [ "$EUID" -eq 0 ] && [ -n "$ROOT" ]; then
        refuse "CUDAPP_ROOT is refused for a delegated root swap"
    fi
    if caller_selected_build; then
        refuse "a delegated kernel swap cannot take --driver-src, --kdir, CUDAPP_DRIVER_SRC or CUDAPP_KDIR; root uses /usr/src/aien-gpu and /lib/modules/<uname -r>/build"
    fi
    # The fixture tests are not root. A real delegated root build also pins make and cc.
    if [ "$EUID" -eq 0 ]; then
        require_trusted_make_path
    fi
    if [ -n "$ROOT" ]; then
        stop=${ROOT%/}
        owner=$(stat -c %u "$stop") || refuse "cannot stat the test machine root"
        src=$stop/usr/src/aien-gpu
        kd=$stop/lib/modules/$KVER/build
    else
        stop=/
        owner=0
        src=/usr/src/aien-gpu
        kd=/lib/modules/$KVER/build
    fi
    [ -d "$src" ] || [ -L "$src" ] || refuse "trusted aien_gpu source not found at /usr/src/aien-gpu"
    walk_owned "$src" "$stop" "$owner"
    shown=$(find -P "$src" \( -type l -o ! -uid "$owner" -o -perm /022 -o ! \( -type f -o -type d \) \) -print -quit 2>/dev/null) || \
        refuse "cannot inspect trusted aien_gpu source at /usr/src/aien-gpu"
    [ -z "$shown" ] || refuse "trusted aien_gpu source must contain no symlink, be owned by uid $owner, and not be writable by group or other: $shown"
    [ -f "$src/Kbuild" ] && [ ! -L "$src/Kbuild" ] || refuse "trusted aien_gpu source has no regular Kbuild at /usr/src/aien-gpu"
    while IFS= read -r shown; do
        [ -n "$shown" ] || continue
        refuse "trusted aien_gpu source has an ACL: $shown"
    done < <(find -P "$src" \( -type f -o -type d \) -exec ls -ld {} + | awk 'substr($1, 11, 1) == "+" { print $NF; exit }')
    # /lib is a symlink to usr/lib on a merged /usr, and the kernel build dir is often itself a symlink
    # into /usr/src. Follow those links. Each link is owned by the trusted uid, and every real directory
    # on the resolved path is owned by that uid and not group/other-writable. The result stays under the
    # machine root, and on the real system under /lib/modules, /usr/lib/modules or /usr/src.
    [ -e "$kd" ] || [ -L "$kd" ] || refuse "kernel headers for $KVER not found at /lib/modules/$KVER/build"
    follow_trusted "$kd" "$stop" "$owner"
    target=$RESOLVED
    if [ -z "$ROOT" ]; then
        case $target in /lib/modules/*|/usr/lib/modules/*|/usr/src/*) ;; *) refuse "kernel build dir $target is not under /lib/modules or /usr/src";; esac
    fi
    [ -d "$target" ] || refuse "kernel build dir $target is not a directory"
    DRIVER_SRC=$src
    KDIR=$target
}
# Resolve $1 by following symlinks. Sets RESOLVED. Components at or above $2 are the trust boundary
# (the fixture root in a test, / on the machine) and are not walked. A link that leaves $2 is refused.
follow_trusted() {
    local path=$1 stop=$2 owner=$3
    local rest cur part next link dest suffix old hops=0
    if [ "$stop" = / ]; then
        case $path in /*) ;; *) refuse "trusted path is outside the machine root: $path";; esac
    else
        case $path in
            "$stop"|"$stop"/*) ;;
            *) refuse "trusted path is outside the machine root: $path";;
        esac
    fi
    if [ "$stop" = / ]; then
        rest=${path#/}
        cur=
    else
        path_owner_mode "$stop" "$owner"
        rest=${path#"$stop"}
        rest=${rest#/}
        cur=$stop
    fi
    while [ -n "$rest" ]; do
        part=${rest%%/*}
        if [ "$part" = "$rest" ]; then rest=; else rest=${rest#*/}; fi
        case $part in
            ''|.) continue;;
            ..)
                if [ "$cur" = "$stop" ] || [ -z "$cur" ] || [ "$cur" = / ]; then
                    refuse "trusted path climbs above its root: $path"
                fi
                cur=${cur%/*}
                [ -n "$cur" ] || cur=/
                continue;;
        esac
        if [ -z "$cur" ] || [ "$cur" = / ]; then next=/$part; else next=$cur/$part; fi
        if [ -L "$next" ]; then
            hops=$((hops + 1))
            [ "$hops" -le 16 ] || refuse "trusted path has too many symlinks: $path"
            path_owner_mode "$next" "$owner"
            link=$(readlink "$next") || refuse "cannot read symlink $next"
            case $link in
                /*) dest=$link;;
                *) dest=$(dirname "$next")/$link;;
            esac
            dest=$(normalize "$dest")
            old=$rest
            if [ "$stop" = / ]; then
                rest=${dest#/}
                cur=
            else
                case $dest in
                    "$stop"|"$stop"/*) ;;
                    *) refuse "trusted path resolves outside the machine root: $dest";;
                esac
                suffix=${dest#"$stop"}
                suffix=${suffix#/}
                rest=$suffix
                cur=$stop
            fi
            if [ -n "$old" ]; then
                if [ -n "$rest" ]; then rest=$rest/$old; else rest=$old; fi
            fi
            continue
        fi
        path_owner_mode "$next" "$owner"
        cur=$next
    done
    [ -n "$cur" ] || cur=/
    RESOLVED=$cur
}
# Directories and binaries a delegated root build may execute. Caller environment is not consulted.
require_trusted_make_path() {
    local d tool path dirs
    TRUSTED_PATH_OK=
    IFS=: read -r -a dirs <<'EOF'
/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EOF
    for d in "${dirs[@]}"; do
        [ -e "$d" ] || [ -L "$d" ] || continue
        follow_trusted "$d" / 0
        if [ -n "$TRUSTED_PATH_OK" ]; then TRUSTED_PATH_OK=$TRUSTED_PATH_OK:$RESOLVED
        else TRUSTED_PATH_OK=$RESOLVED; fi
    done
    [ -n "$TRUSTED_PATH_OK" ] || refuse "no trusted directory on the make PATH"
    for tool in make cc; do
        path=$(PATH=$TRUSTED_PATH_OK command -v "$tool") || refuse "$tool is not on the trusted PATH"
        follow_trusted "$path" / 0
        [ -f "$RESOLVED" ] && [ ! -L "$RESOLVED" ] || refuse "$tool does not resolve to a regular file: $path"
    done
}

# ---------------------------------------------------------------- facts
gpu_ids() { # prints "vendor:device" of every NVIDIA PCI function
    local d
    for d in "$ROOT"/sys/bus/pci/devices/*; do
        [ -r "$d/vendor" ] || continue
        [ "$(cat "$d/vendor")" = 0x10de ] || continue
        echo "10de:$(sed 's/^0x//' "$d/device")"
    done
}
is_gb10()       { gpu_ids | grep -qx "10de:2e12"; }
nv_version()    { cat "$ROOT/sys/module/nvidia/version" 2>/dev/null || echo "not loaded"; }
secure_boot()   { local s; s=$(mokutil --sb-state 2>/dev/null); case $s in *enabled*) echo enabled;; *disabled*) echo disabled;; *) echo unknown;; esac; }
holders()       { fuser "$ROOT"/dev/nvidia* 2>/dev/null | tr -s ' :' '\n' | grep -E '^[0-9]+$' | sort -un | tr '\n' ' '; }
free_mb()       { df -Pm "${ROOT:-/}" 2>/dev/null | awk 'NR==2{print $4}'; }
loader_choice() { # which libcuda.so.1 the dynamic loader finds first
    if [ -n "$ROOT" ]; then
        if [ -f "$ROOT$LDCONF" ] && [ -e "$ROOT$OUR_LIBDIR/libcuda.so.1" ]; then echo "$OUR_LIBDIR/libcuda.so.1"; return; fi
        echo "/usr/lib/aarch64-linux-gnu/libcuda.so.1"; return
    fi
    ldconfig -p 2>/dev/null | awk '$1=="libcuda.so.1"{print $NF; exit}'
}
user_swapped()   { [ -f "$ROOT$LDCONF" ]; }
kernel_staged()  { [ -f "$ROOT$MODCONF" ]; }
nv_in_initramfs(){ lsinitramfs "$ROOT$INITRD" 2>/dev/null | grep -qE '/nvidia(_uvm|_modeset|_drm)?\.ko'; }

status() {
    local ids; ids=$(gpu_ids | tr '\n' ' ')
    if is_gb10; then echo "GPU: NVIDIA GB10 (10de:2e12)"; else echo "GPU: ${ids:-no NVIDIA GPU found} (not a GB10)"; fi
    echo "NVIDIA kernel driver: $(nv_version)"
    echo "Secure Boot: $(secure_boot)"
    echo "free disk: $(free_mb) MB"
    local h; h=$(holders); echo "holding /dev/nvidia*: ${h:-nobody}"
    local c; c=$(loader_choice)
    case $c in *cudapp*) echo "libcuda.so.1: CUDA++ ($c)";; "") echo "libcuda.so.1: none found";; *) echo "libcuda.so.1: NVIDIA ($c)";; esac
    if user_swapped; then echo "user level: SWAPPED (CUDA++ libcuda.so.1 first in the loader's search)"; else echo "user level: NVIDIA"; fi
    if kernel_staged; then
        if [ -d "$ROOT/sys/module/aien_gpu" ] && [ ! -d "$ROOT/sys/module/nvidia" ]; then echo "kernel level: SWAPPED (aien_gpu loaded, NVIDIA held back)"
        else echo "kernel level: STAGED (takes effect at the next boot)"; fi
    else echo "kernel level: NVIDIA"; fi
    local b; b=$(ls -d "$STATE"/backup-* 2>/dev/null | tr '\n' ' '); echo "backups: ${b:-none}"
}

# ---------------------------------------------------------------- backup + restore
BK=""
backup_begin() { # $1 = level
    BK=$STATE/backup-$(date -u +%Y%m%dT%H%M%SZ)-$1
    mkdir -p "$BK/files" || die "cannot create $BK"
    : > "$BK/manifest.tsv"
}
backup_file() { # $1 = path (system path, without ROOT): copy + record state and hash before we touch it
    local p=$1 f=$ROOT$1
    grep -q "^$p	" "$BK/manifest.tsv" 2>/dev/null && return 0
    if [ -L "$f" ]; then
        printf '%s\tlink\t%s\n' "$p" "$(readlink "$f")" >> "$BK/manifest.tsv"
    elif [ -e "$f" ]; then
        mkdir -p "$BK/files$(dirname "$p")"; cp -p "$f" "$BK/files$p" || die "backup of $p failed"
        printf '%s\tfile\t%s\n' "$p" "$(sha "$f")" >> "$BK/manifest.tsv"
    else
        printf '%s\tabsent\t-\n' "$p" >> "$BK/manifest.tsv"
    fi
}
backup_done() { echo applied > "$BK/APPLIED"; echo "backup: $BK ($(wc -l < "$BK/manifest.tsv") files recorded)"; }

restore_one() { # $1 = backup dir; restores and checks; prints MISMATCH lines; returns count of mismatches
    local b=$1 bad=0 p kind val f
    while IFS=$'\t' read -r p kind val; do
        f=$ROOT$p
        case $kind in
            absent) rm -f "$f"
                    if [ -e "$f" ] || [ -L "$f" ]; then echo "MISMATCH $p: still present"; bad=$((bad+1)); fi ;;
            link)   rm -f "$f"; ln -s "$val" "$f"
                    [ "$(readlink "$f")" = "$val" ] || { echo "MISMATCH $p: link"; bad=$((bad+1)); } ;;
            file)   mkdir -p "$(dirname "$f")"; rm -f "$f"; cp -p "$b/files$p" "$f"
                    [ "$(sha "$f")" = "$val" ] || { echo "MISMATCH $p: sha256 $(sha "$f") != recorded $val"; bad=$((bad+1)); } ;;
        esac
    done < <(tac "$b/manifest.tsv")
    rmdir "$ROOT$OUR_LIBDIR" "$ROOT$MODDIR" 2>/dev/null   # only the directories this tool creates, and only if empty
    return $bad
}

# ---------------------------------------------------------------- levels
plan() { if [ $YES -eq 1 ]; then echo "  * $*"; else echo "  - would: $*"; fi; }

user_level() {
    echo "== user level: CUDA++ libcuda.so.1 replaces NVIDIA's for every program the loader starts"
    [ -f "$LIB_SRC" ] || refuse "CUDA++ libcuda.so.1 not built at $LIB_SRC (run: make libcuda)"
    user_swapped && { echo "already swapped ($LDCONF present); nothing to do"; return 0; }
    local want; want=$(sha "$LIB_SRC")
    plan "install $LIB_SRC as $OUR_LIBDIR/libcuda.so.1 (sha256 $(cut -c1-16 <<<"$want"))"
    plan "write $LDCONF -> $OUR_LIBDIR, so the loader searches it before $(loader_choice | xargs -r dirname)"
    plan "run ldconfig (rewrites $LDCACHE; the old one is kept in the backup)"
    echo "  NVIDIA's libcuda files stay installed and unchanged; 'cudapp swap back' restores the old search order."
    [ $YES -eq 1 ] || return 0
    backup_begin user
    backup_file "$OUR_LIBDIR/libcuda.so.1"; backup_file "$LDCONF"; backup_file "$LDCACHE"
    mkdir -p "$ROOT$OUR_LIBDIR" && install -m 0755 "$LIB_SRC" "$ROOT$OUR_LIBDIR/libcuda.so.1" || die "install failed"
    local got; got=$(sha "$ROOT$OUR_LIBDIR/libcuda.so.1")
    if [ "$got" != "$want" ]; then
        restore_one "$BK"; mv "$BK" "$BK.undone"
        die "installed libcuda.so.1 sha256 $got != $want planned from $LIB_SRC (source changed during install); restored"
    fi
    printf '%s  %s\n' "$want" "$OUR_LIBDIR/libcuda.so.1" > "$BK/installed.sha256"
    echo "$OUR_LIBDIR" > "$ROOT$LDCONF"
    ldconfig ${ROOT:+-r "$ROOT"} || die "ldconfig failed"
    backup_done
    local c; c=$(loader_choice)
    case $c in *cudapp*) echo "loader now finds: $c";; *) echo "loader still finds $c: restoring"; restore_one "$BK"; mv "$BK" "$BK.undone"; die "swap did not take";; esac
}

kernel_level() {
    echo "== kernel level: AIEN's aien_gpu driver (ledger L332) instead of NVIDIA's open kernel modules"
    is_gb10 || refuse "no GB10 here (found: $(gpu_ids | tr '\n' ' ')); aien_gpu drives the GB10 (10de:2e12) only"
    local sb; sb=$(secure_boot)
    [ "$sb" = enabled ] && refuse "Secure Boot is enabled: the kernel would refuse the unsigned aien_gpu module and boot with no GPU driver. Disable Secure Boot or enrol a signing key first."
    [ -f "$DRIVER_SRC/Kbuild" ] || refuse "aien_gpu source not found at $DRIVER_SRC (set CUDAPP_DRIVER_SRC)"
    [ -d "$KDIR" ] || refuse "kernel headers for $KVER not found at $KDIR (install linux-headers-$KVER)"
    local h; h=$(holders)
    if [ -n "$h" ]; then
        echo "  processes holding /dev/nvidia* (they lose the GPU at the reboot): $h"
        [ $YES -eq 1 ] && [ $HOLDERS_OK -eq 0 ] && refuse "processes hold /dev/nvidia*: $h. Stop them (or pass --holders-ok to stage the switch for the next boot anyway)."
    fi
    local need=$(( $(stat -c %s "$ROOT$INITRD" 2>/dev/null || echo 0) / 1048576 * 2 + 64 ))
    [ "$(free_mb)" -ge "$need" ] 2>/dev/null || refuse "not enough free disk: need $need MB for the module and the initramfs backup, have $(free_mb) MB"
    plan "build aien_gpu.ko from $DRIVER_SRC for kernel $KVER and install it as $MODDIR/aien_gpu.ko"
    plan "write $MODCONF: blacklist + 'install <m> /bin/false' for $NV_MODULES (nothing loads them, not even an explicit modprobe)"
    plan "write $MODLOAD: load aien_gpu at boot (options aien_gpu allow_bind=1)"
    plan "run depmod -a $KVER (modules.* files are kept in the backup)"
    if nv_in_initramfs; then plan "run update-initramfs -u -k $KVER (NVIDIA modules are in $INITRD; the old initramfs is kept in the backup)"
    else echo "  initramfs: no NVIDIA module in $INITRD, the hold-back file is enough (not rebuilt)"; fi
    echo "  takes effect at the next reboot: NVIDIA's modules then stay unloaded and aien_gpu owns the GB10."
    echo "  Why a reboot: unloading nvidia_modeset can hang on this machine (L158), so the switch never unloads a live driver."
    echo "  NVIDIA's signed GSP firmware stays installed; aien_gpu loads it (the chip checks its signature)."
    [ $YES -eq 1 ] || return 0
    backup_begin kernel
    local m
    backup_file "$MODDIR/aien_gpu.ko"; backup_file "$MODCONF"; backup_file "$MODLOAD"
    for m in "$ROOT"/lib/modules/$KVER/modules.*; do [ -e "$m" ] && backup_file "${m#$ROOT}"; done
    nv_in_initramfs && backup_file "$INITRD"
    local B; B=$(mktemp -d) && cp -a -- "$DRIVER_SRC"/. "$B"/ || die "copy of driver source failed"
    # A delegated root build must not inherit CC, MAKEFLAGS or LD_PRELOAD from `sudo VAR=value`.
    # sudoers without SETENV already rejects those assignments; this is the same boundary for make.
    if [ "$EUID" -eq 0 ] && sudo_origin; then
        env -i PATH="$TRUSTED_PATH_OK" HOME="${HOME:-/root}" \
            make -C "$KDIR" M="$B" modules > "$BK/build.log" 2>&1 || { cat "$BK/build.log" >&2; die "aien_gpu build failed (log $BK/build.log)"; }
    else
        make -C "$KDIR" M="$B" modules > "$BK/build.log" 2>&1 || { cat "$BK/build.log" >&2; die "aien_gpu build failed (log $BK/build.log)"; }
    fi
    local vm; vm=$(modinfo -F vermagic "$B/aien_gpu.ko" 2>/dev/null; modinfo "$B/aien_gpu.ko" 2>/dev/null | awk '/^vermagic/{print $2}')
    grep -q "$KVER" <<<"$vm" || die "built module vermagic '$vm' does not match running kernel $KVER"
    mkdir -p "$ROOT$MODDIR" && install -m 0644 "$B/aien_gpu.ko" "$ROOT$MODDIR/aien_gpu.ko" || die "module install failed"
    rm -rf "$B"
    { echo "# cudapp swap kernel: NVIDIA's kernel modules held back, AIEN aien_gpu drives the GB10. Undo: cudapp swap back"
      for m in $NV_MODULES; do echo "blacklist $m"; echo "install $m /bin/false"; done
      echo "options aien_gpu allow_bind=1"; } > "$ROOT$MODCONF"
    { echo "# cudapp swap kernel"; echo "aien_gpu"; } > "$ROOT$MODLOAD"
    depmod -a "$KVER" || die "depmod failed"
    if nv_in_initramfs || [ -f "$BK/files$INITRD" ]; then update-initramfs -u -k "$KVER" || die "update-initramfs failed"; fi
    backup_done
    echo "kernel level STAGED: reboot to switch. To return: cudapp swap back --yes, then reboot."
    if [ $REBOOT -eq 1 ]; then
        window_host && [ -z "${SPARK_WINDOW:-}" ] && refuse "on the Spark the reboot runs only inside a scheduled spark-window"
        echo "rebooting (--reboot)"; reboot
    fi
}

back_level() {
    local list; list=$(ls -d "$STATE"/backup-* 2>/dev/null | grep -v -e '\.undone$' -e '\.restored$' | LC_ALL=C sort -r)
    [ -n "$list" ] || { echo "nothing to restore: no applied backup in $STATE"; return 0; }
    echo "== back: restore NVIDIA's stack from"; echo "$list" | sed 's/^/   /'
    local b
    for b in $list; do [ -f "$b/APPLIED" ] && sed 's/^/  - restore: /' "$b/manifest.tsv"; done
    [ $YES -eq 1 ] || { echo "DRY RUN: nothing changed. Run again with --yes."; return 0; }
    local total=0 bad=0 n
    for b in $list; do
        [ -f "$b/APPLIED" ] || continue
        restore_one "$b"; n=$?; bad=$((bad+n)); total=$((total+$(wc -l < "$b/manifest.tsv")))
        [ $n -eq 0 ] && mv "$b" "$b.restored"
    done
    if [ $bad -eq 0 ]; then
        echo "BACK PASS: $total files match their pre-swap state (sha256)"
        [ -d "$ROOT/sys/module/aien_gpu" ] && echo "aien_gpu is loaded now: reboot to give the GB10 back to NVIDIA's driver."
        return 0
    fi
    echo "BACK FAIL: $bad of $total files do not match; backups kept in $STATE"; return 1
}

# ---------------------------------------------------------------- main
[ $# -ge 1 ] || usage
cmd=$1; shift
if [ "$cmd" = run ]; then
    [ $# -ge 1 ] || usage
    d=$(cd "$(dirname "$LIB_SRC")" 2>/dev/null && pwd) || refuse "CUDA++ libcuda.so.1 not built at $LIB_SRC (run: make libcuda)"
    LD_LIBRARY_PATH=$d${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH} exec "$@"
fi
[ "$cmd" = swap ] || usage
[ $# -ge 1 ] || usage
level=$1; shift
while [ $# -gt 0 ]; do
    case $1 in
        --yes) YES=1;; --reboot) REBOOT=1;; --holders-ok) HOLDERS_OK=1;;
        --in-spark-window) SPARK_WINDOW=1;;
        --lib|--driver-src|--kdir)
            [ $# -ge 2 ] && [ -n "$2" ] || usage
            case $1 in
                --lib) LIB_SRC=$2;;
                --driver-src) DRIVER_SRC=$2; DRIVER_SRC_OPTION=1;;
                --kdir) KDIR=$2; KDIR_OPTION=1;;
            esac
            shift;;
        *) usage;;
    esac
    shift
done
case $level in status|user|kernel|all|back) ;; *) usage;; esac
if [ $YES -eq 1 ] && [ -z "$ROOT" ] && [ "$(id -u)" -ne 0 ]; then
    # No -E: root gets a clean environment. The module source and the kernel build dir are chosen
    # again in the root process; they are not arguments a delegated caller can set.
    case $level in
        kernel|all)
            if caller_selected_build; then
                refuse "a delegated kernel swap cannot take --driver-src, --kdir, CUDAPP_DRIVER_SRC or CUDAPP_KDIR; root uses /usr/src/aien-gpu and /lib/modules/<uname -r>/build"
            fi
            ;;
    esac
    set -- --yes
    [ $REBOOT -eq 1 ] && set -- "$@" --reboot
    [ $HOLDERS_OK -eq 1 ] && set -- "$@" --holders-ok
    [ -n "${SPARK_WINDOW:-}" ] && set -- "$@" --in-spark-window
    case $level in user|all) set -- "$@" --lib "$(readlink -m "$LIB_SRC")";; esac
    exec sudo "$SELF" swap "$level" "$@"
fi
if delegated_build; then
    apply_delegated_sources
fi
# As root on the real system, refuse sources outside the places a root install may read from.
if [ -z "$ROOT" ] && [ "$(id -u)" -eq 0 ]; then
    case $level in
        user|all)
            lib=$(readlink -e "$LIB_SRC") || refuse "--lib $LIB_SRC does not exist"
            case $lib in "$REPO_DIR"/*) ;; *) refuse "--lib $lib is outside the CUDA++ repository $REPO_DIR";; esac
            [ -f "$lib" ] || refuse "--lib $lib is not a regular file"
            LIB_SRC=$lib ;;
    esac
    case $level in
        kernel|all)
            kd=$(readlink -e "$KDIR") || refuse "--kdir $KDIR does not exist"
            case $kd in /lib/modules/*|/usr/lib/modules/*|/usr/src/*) ;; *) refuse "--kdir $kd is not under /lib/modules or /usr/src";; esac
            KDIR=$kd ;;
    esac
fi
case $level in
    status) status ;;
    user)   user_level ;;
    kernel) kernel_level ;;
    all)    user_level && kernel_level ;;
    back)   back_level ;;
esac
rc=$?
[ $YES -eq 0 ] && [ "$level" != status ] && [ "$level" != back ] && echo "DRY RUN: nothing changed. Run again with --yes."
exit $rc
