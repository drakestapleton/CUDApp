# launch3: external Python measuring harness; the production launcher is seeded Omega.
import base64, ctypes, hashlib, json, lzma, os, platform, selectors, struct, subprocess, tempfile, time
from pathlib import Path
BUNDLE = json.loads(r'''@BUNDLE@''')
REPORT = Path('amdserve-launch3.txt')
ROWS = []
WORK = None
ASSETS = {}
BIN = None
KFD_PROC_ROOT = Path('/sys/class/kfd/kfd/proc')
SAMPLE_DELAYS = (0.0, 1.0, 3.0)
REFERENCE = 'REFERENCE (AMD runtime loading our object, not the Omega launcher)'
def say(line):
    ROWS.append(str(line).replace('\n',' '))
    temp=REPORT.with_suffix('.tmp'); temp.write_text('\n'.join(ROWS)+'\n'); temp.replace(REPORT)
    print(ROWS[-1],flush=True)
def asset(name):
    a=BUNDLE['assets'][name]; data=lzma.decompress(base64.b85decode(a['xz_base85']))
    if hashlib.sha256(data).hexdigest()!=a['sha256']: raise RuntimeError('asset digest '+name)
    p=WORK/name; p.write_bytes(data)
    if name=='omega-launch': p.chmod(0o700)
    return p
def topology_table():
    root=Path('/sys/class/kfd/kfd/topology/nodes')
    try: nodes=sorted(root.iterdir(),key=lambda p: int(p.name) if p.name.isdecimal() else -1)
    except OSError as exc:
        say('OMEGA topology table fail errno='+str(exc.errno)+' path='+str(root)); return
    for node in nodes:
        if not node.name.isdecimal(): continue
        values={'node':node.name}
        for name in ('gpu_id','properties'):
            try:
                data=(node/name).read_text()
                if name=='gpu_id': values[name]=data.strip()
                else:
                    props=dict(line.split(None,1) for line in data.splitlines() if len(line.split(None,1))==2)
                    values.update({k:props.get(k,'missing') for k in ('gfx_target_version','drm_render_minor','simd_count','device_id')})
            except OSError as exc: values[name+'_errno']=exc.errno
        say('OMEGA topology table '+json.dumps(values,sort_keys=True))
def sample_kfd(pid,index):
    root=KFD_PROC_ROOT/str(pid)
    prefix='OMEGA proc sample='+str(index)+' pid='+str(pid)+' '
    def contents(path):
        try:
            names=sorted(p.name for p in path.iterdir())
            say(prefix+str(path)+' entries='+json.dumps(names)); return names
        except OSError as exc:
            say(prefix+str(path)+' missing/unreadable errno='+str(exc.errno)); return []
    def value(path):
        try:
            data=path.read_text().strip(); say(prefix+str(path)+' value='+json.dumps(data)); return data
        except OSError as exc:
            say(prefix+str(path)+' missing/unreadable errno='+str(exc.errno)); return None
    names=contents(root)
    gpuids=set()
    for queue in contents(root/'queues'):
        for field in ('size','type','gpuid'):
            data=value(root/'queues'/queue/field)
            if field=='gpuid' and data and data.isdecimal(): gpuids.add(data)
    for name in names:
        for stem in ('stats_','vram_'):
            if name.startswith(stem) and name[len(stem):].isdecimal(): gpuids.add(name[len(stem):])
    if not gpuids: say(prefix+'stats_<gpuid>/cu_occupancy and vram_<gpuid> missing: no observed gpuid')
    for gpu in sorted(gpuids):
        value(root/('stats_'+gpu)/'cu_occupancy')
        value(root/('vram_'+gpu))

def invoke(arguments,label,expected=0,sample=False):
    start=time.perf_counter_ns()
    command=[str(BIN),*map(str,arguments)]
    say('OMEGA invocation '+json.dumps({'label':label,'argv':command},sort_keys=True))
    streams={'stdout':bytearray(),'stderr':bytearray()}
    pending={'stdout':b'','stderr':b''}
    waiting=None; sampled=0
    with subprocess.Popen(command,stdout=subprocess.PIPE,stderr=subprocess.PIPE) as child:
        with selectors.DefaultSelector() as selector, (WORK/(label+'.stdout')).open('wb') as out, (WORK/(label+'.stderr')).open('wb') as err:
            logs={'stdout':out,'stderr':err}
            selector.register(child.stdout,selectors.EVENT_READ,'stdout')
            selector.register(child.stderr,selectors.EVENT_READ,'stderr')
            deadline=time.monotonic()+330
            try:
                while selector.get_map():
                    now=time.monotonic(); left=deadline-now
                    if left<=0: raise subprocess.TimeoutExpired(command,330)
                    if waiting is not None and sampled<len(SAMPLE_DELAYS):
                        due=waiting+SAMPLE_DELAYS[sampled]-now
                        if due<=0:
                            sample_kfd(child.pid,sampled); sampled+=1
                            continue
                        left=min(left,due)
                    for key,_ in selector.select(left):
                        data=os.read(key.fileobj.fileno(),65536); kind=key.data
                        if not data:
                            selector.unregister(key.fileobj)
                            if pending[kind]:
                                say(pending[kind].decode(errors='replace') if kind=='stdout' else 'OMEGA stderr '+pending[kind].decode(errors='replace'))
                                pending[kind]=b''
                            continue
                        streams[kind].extend(data); logs[kind].write(data); logs[kind].flush()
                        pending[kind]+=data
                        while b'\n' in pending[kind]:
                            line,pending[kind]=pending[kind].split(b'\n',1)
                            say(line.decode(errors='replace') if kind=='stdout' else 'OMEGA stderr '+line.decode(errors='replace'))
                            if sample and kind=='stdout' and line.startswith(b'OMEGA step signal_wait ') and b'phase=before' in line:
                                waiting=time.monotonic()
                code=child.wait(timeout=max(0.001,deadline-time.monotonic()))
            except BaseException:
                child.kill(); child.wait()
                for kind,data in pending.items():
                    if data: say(data.decode(errors='replace') if kind=='stdout' else 'OMEGA stderr '+data.decode(errors='replace'))
                raise
    elapsed=time.perf_counter_ns()-start
    p=subprocess.CompletedProcess(command,code,bytes(streams['stdout']),bytes(streams['stderr']))
    say('OMEGA invocation '+label+' exit='+str(code)+' expected='+str(expected))
    if sample: say('OMEGA proc samples='+str(sampled)+'; missing samples mean child exited before scheduled read or wait was not reached')
    if expected is not None and p.returncode!=expected: raise RuntimeError(label+' exit='+str(p.returncode)+' expected='+str(expected))
    return p,elapsed

class Hip:
    def __init__(self):
        # Import the installed torch only to load its AMD runtime; no torch kernels.
        import torch
        say(REFERENCE+' torch_version='+str(torch.__version__)+' hip_build='+str(torch.version.hip))
        paths=set()
        for line in Path('/proc/self/maps').read_text().splitlines():
            fields=line.split(None,5)
            if len(fields)==6 and Path(fields[5]).name.startswith('libamdhip64.so'): paths.add(fields[5])
        if len(paths)!=1: raise RuntimeError('expected one torch-loaded libamdhip64, observed '+repr(sorted(paths)))
        self.name=paths.pop(); self.lib=ctypes.CDLL(self.name)
        P=ctypes.c_void_p; U=ctypes.c_uint; Z=ctypes.c_size_t; I=ctypes.c_int
        signatures={'hipInit':[U],'hipRuntimeGetVersion':[ctypes.POINTER(I)],'hipMalloc':[ctypes.POINTER(P),Z], 'hipFree':[P], 'hipMemcpy':[P,P,Z,I], 'hipModuleLoadData':[ctypes.POINTER(P),P], 'hipModuleGetFunction':[ctypes.POINTER(P),P,ctypes.c_char_p], 'hipModuleUnload':[P], 'hipModuleLaunchKernel':[P,U,U,U,U,U,U,U,P,ctypes.POINTER(P),ctypes.POINTER(P)], 'hipDeviceSynchronize':[]}
        for name,types in signatures.items():
            fn=getattr(self.lib,name); fn.argtypes=types; fn.restype=I
        self.call('hipInit',0); version=I(); self.call('hipRuntimeGetVersion',ctypes.byref(version))
        say(REFERENCE+' library='+self.name+' runtime_version='+str(version.value))
    def call(self,name,*args):
        rc=getattr(self.lib,name)(*args)
        say(REFERENCE+' '+name+' rc='+str(rc))
        if rc: raise RuntimeError(REFERENCE+' '+name+' rc='+str(rc))
    def vadd(self):
        P=ctypes.c_void_p; ptrs=[]; mod=P()
        try:
            # Identical 256 binary32 ones and NaN output fill to the Omega vadd.
            for data in [struct.pack('<f',1.0)*256]*2+[struct.pack('<I',0x7fc00000)*256]:
                ptr=P(); self.call('hipMalloc',ctypes.byref(ptr),len(data)); ptrs.append(ptr)
                host=ctypes.create_string_buffer(data); self.call('hipMemcpy',ptr,host,len(data),1)
            image=ctypes.create_string_buffer(ASSETS['vadd.hsaco'].read_bytes())
            self.call('hipModuleLoadData',ctypes.byref(mod),image)
            fn=P(); self.call('hipModuleGetFunction',ctypes.byref(fn),mod,b'vadd')
            values=ptrs+[ctypes.c_uint32(256)]
            params=(P*len(values))(*(ctypes.addressof(v) for v in values))
            self.call('hipModuleLaunchKernel',fn,4,1,1,64,1,1,0,None,params,None)
            self.call('hipDeviceSynchronize')
            result=ctypes.create_string_buffer(1024); self.call('hipMemcpy',result,ptrs[-1],1024,2)
            say(REFERENCE+' first8_words='+json.dumps(struct.unpack('<8I',result.raw[:32])))
            if result.raw!=struct.pack('<f',2.0)*256: raise RuntimeError(REFERENCE+' output bits differ')
            say(REFERENCE+' vadd bitwise=PASS count=256 same_object_sha256='+BUNDLE['assets']['vadd.hsaco']['sha256'])
        finally:
            if mod.value: self.call('hipModuleUnload',mod)
            for ptr in ptrs: self.call('hipFree',ptr)

def main():
    if platform.machine()!='x86_64':
        say('OMEGA NOT_RUN target requires x86_64 Linux; AMD device rows NOT_RUN'); return 'NOT_RUN'
    bad=WORK/'bad.hsaco'; bad.write_bytes(b'bad ELF')
    invoke(['inspect',bad,'vadd'],'control-bad-elf',65)
    args=WORK/'bad.args'; args.write_bytes(bytes(48))
    invoke(['run',ASSETS['vadd.hsaco'],'vadd',4,1,args,WORK/'unused'],'control-bad-args',64)
    say('OMEGA CONTROL malformed ELF=65 argument-header=64 PASS')
    if not Path('/dev/kfd').exists():
        invoke(['vadd',ASSETS['vadd.hsaco'],'vadd'],'absent-kfd',77)
        say('OMEGA NOT_RUN /dev/kfd absent; errno=2 exit=77 checked'); return 'NOT_RUN'
    p,_=invoke(['vadd',ASSETS['vadd.hsaco'],'vadd'],'vadd',expected=None,sample=True)
    omega_ok=p.returncode==0 and b'OMEGA vadd=PASS count=256\n' in p.stdout
    say('OMEGA vadd '+('bitwise=PASS' if omega_ok else 'FAIL_OR_INCOMPLETE')+' exit='+str(p.returncode)+' timeout='+str(p.returncode==75))
    # Run this independent comparison even when the direct launcher timed out.
    hip_ok=False
    try:
        Hip().vadd(); hip_ok=True
    except Exception as exc:
        say(REFERENCE+' FAIL_OR_NOT_RUN '+type(exc).__name__+' '+str(exc))
    say('NOT_RUN full 27B serving, Spark comparison and all other kernels; no dispatch variants attempted')
    return 'PASS vadd only' if omega_ok and hip_ok else 'FAIL_OR_INCOMPLETE vadd diagnostics retained'

def run():
    global WORK,ASSETS,BIN
    ROWS.clear()
    say('CONTROLS first: asset digests, malformed ELF, argument header; no changed doorbell values or dispatch variants')
    result='FAIL'
    try:
        WORK=Path(tempfile.mkdtemp(prefix='omega-launch3-'))
        try: ASSETS={name:asset(name) for name in BUNDLE['assets']}
        except Exception as exc:
            say('FAIL asset unpack: '+str(exc)); raise
        BIN=ASSETS['omega-launch']
        say('launch3 candidate; OMEGA=seeded direct KFD; '+REFERENCE+'=independent comparison')
        say('pins '+json.dumps(BUNDLE['sources'],sort_keys=True))
        say('assets '+json.dumps({k:v['sha256'] for k,v in BUNDLE['assets'].items()},sort_keys=True))
        say('host arch='+platform.machine()+' kernel='+platform.release()+' libc='+str(platform.libc_ver())+' work='+str(WORK))
        topology_table()
        result=main()
    except BaseException as exc:
        say('FAIL '+type(exc).__name__+' '+str(exc)+'; full stdout/stderr files in '+str(WORK))
        raise
    finally:
        say('receipt '+str(REPORT.resolve())+'; inputs, outputs and invocation logs retained in '+str(WORK))
        say('RESULT '+result)

if __name__!='__notebook_test__':
    run()
