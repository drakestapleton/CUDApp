fn gpurun to int
if not bexists 30
notrun TNoCtl
end
if not which TSpark
notrun TNoSw
end
bclr 18
bb 18 19
if not which TSmi
notrun TNoSmi
end
bclr 17
bb 17 19
if not which TSha
notrun TNoSha
end
bclr 31
bb 31 19
if not which TGit
notrun TNoGit
end
mkdirp 4
envtxt
bpath1 27 TLeaseT
bs 26 TOpenR
bstamp 26 1
bt 26 TNL
bfile 27 26 578
alenv
alt TOpen
alt TName
alt TLedg
alt TDRA
alt TLeas
alt T20
alt TGb
alt TExcl
alt TQuiet
alt TNone
alt TWait
rc = runwait 1 27
bpath1 29 TCapT
alenv
alt TId
rc = capture
bclr 15
if eq rc 0
bb 15 3
end
if eq get Bn 15 0
catfile 27
notrun TNoLease
end
lnote 27 TLease TStart
bpath1 29 TWinT
alenv
alt TRun
alpin
alb 5
alt TMIn
alb 4
alb 6
alb 7
bclr 3
bfile 29 3 578
pid = spawn 1 29 0
t0 = monons
rc = neg long 1
while lt rc 0 bound 999999
rc = reap pid 1
if lt rc 0
if gt sub monons t0 1080000000000
x = killpid int pid 15
rc = reap pid 0
rc = long 124
else
x = sleepns 100000000
end
end
end
bs 26 TWrc
bl 26 rc
bt 26 TEnd
bstamp 26 1
bt 26 TNL
bfile 27 26 1089
alenv
alt TClose
alb 15
rc = runwait 1 27
bs 3 TClosed
lnote 27 TClosed TSp
catfile 29
bpath1 27 TVerT
pid = fork
if lt pid 0
bfail
end
if eq pid 0
f = bopen 27 578
if lt f 0
exit 90
end
x = dupfd int f 1 0
exit checkgpu
end
v = reap pid 0
catfile 27
ret int v
end

fn main to int
c = argcnt
if lt c 3
r = write 2 TUse 0 len TUse
ret 2
end
barg 0 5
barg 1 3
barg 2 4
if ne get B mul ulong 5 4096 47
k = cwd B mul ulong 31 4096 4095
if le k 0
bfail
end
put Bn 31 sub ulong k 1
bt 31 TSl
bb 31 5
bclr 5
bb 5 31
end
if ge c 5
barg 3 6
barg 4 7
end
if bist 3 TMChk
ret checkgpu
end
if lt c 5
r = write 2 TUse 0 len TUse
ret 2
end
if bist 3 TMDry
if eq get Bn 4 0
bs 4 TDDry
end
ret dryrun false
end
if bist 3 TMHid
ret dryrun true
end
if bist 3 TMIn
ret inside
end
if bist 3 TMGpu
if eq get Bn 4 0
bs 4 TDGpu
bstamp 4 2
end
bs 30 TCtl
ret gpurun
end
r = write 2 TUse 0 len TUse
ret 2
end
