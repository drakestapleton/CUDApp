fn lexit r ulong to void
bclr r
p = ulong 0
while lt p get Ln 0 bound 999999
e = lend p
if lpre p e TEx
q = add p len TEx
ok = true
while lt q e bound 4096
c = get L q
if or lt c 48 gt c 57
ok = false
end
q = add q 1
end
if ok
bclr r
lcopy add p len TEx e r
end
end
p = add e 1
end
end

note the digits of "hold (D8): pid [0-9]*,..." lines into region r
fn lhold r ulong to void
bclr r
k = ulong 0
p = ulong 0
while lt p get Ln 0 bound 999999
e = lend p
if lpre p e THold
q = add p len THold
while lt q e bound 4096
c = get L q
if or lt c 48 gt c 57
break
end
q = add q 1
end
if lt q e
if eq get L q 44
if gt k 0
bc r 10
end
lcopy add p len THold q r
k = add k 1
end
end
end
p = add e 1
end
end

note line [p, e) against a template: # is [0-9]+, $ is [+-][0-9]+; the numbers go to NV
fn ltpl p ulong e ulong t view uchar * to bool
k = ulong 0
for i ulong len t
c = get t i
if or eq c 35 eq c 36
ng = false
if eq c 36
if ge p e
ret false
end
c = get L p
if eq c 45
ng = true
else
if ne c 43
ret false
end
end
p = add p 1
end
v = long 0
d = ulong 0
while lt p e bound 4096
c = get L p
if or lt c 48 gt c 57
break
end
if ge d 18
ret false
end
v = add mul v 10 long sub c 48
d = add d 1
p = add p 1
end
if eq d 0
ret false
end
if ng
v = neg v
end
put NV k v
k = add k 1
else
if ge p e
ret false
end
if ne get L p c
ret false
end
p = add p 1
end
end
ret eq p e
end

note lines matching the D8 template of kind (1 gpu, 0 sim); NV holds the last match
fn lcntd8 kind ulong to ulong
c = ulong 0
p = ulong 0
while lt p get Ln 0 bound 999999
e = lend p
if eq kind 1
if ltpl p e TReG
c = add c 1
end
else
if ltpl p e TReS
c = add c 1
end
end
p = add e 1
end
ret c
end

note ---- output rows
fn padto r ulong w ulong to void
while lt get Bn r w bound 4096
bc r 32
end
end

note row: bar b, the message in region 1, ok
fn row b ulong ok bool to void
bs 2 TSp
bt 2 TSp
bc 2 66
bu 2 b
padto 2 5
bt 2 TSp
bb 2 1
padto 2 80
bt 2 TSp
if ok
bt 2 TPASS
else
bt 2 TFAIL
bt 14 TBar1
bu 14 b
put J 7 or get J 7 long shl ulong 1 b
end
bt 2 TNL
bout 1 2
end

fn brc r ulong to void
if eq get Bn 28 0
bt r TQm
else
bb r 28
end
end

note ---- the judge. kind 1 gpu, 0 sim. J: 0 verdict (0 PASS, 1 FAIL, 2 NOT_RUN), 1 open set, 2 open, 3 beyond
note set, 4 beyond, 5 tax set, 6 tax, 7 failed bars (bit b). NV after B2: before, open_kib, with, own, drv_alloc.
fn judge12 kind ulong to bool
x = fload 24
lexit 28
if or bist 28 T2 gt lcnt TNR 0 0
bs 2 TRunNR
brc 2
bt 2 TRunNR2
lfirst2 TNAv TNR 2
bt 2 TNL
bout 1 2
put J 0 2
ret false
end
ok = and and bist 28 T0 gt lcnt TChk 0 0 and gt lcnt TPASS 0 0 eq lcnt TFAIL 0 0
if ok
bs 1 TB1ok
row 1 true
else
bs 1 TB1a
brc 1
bt 1 TCm
if not lfirst TChkP 1
bt 1 TNoChk
end
row 1 false
end
n = lcntd8 kind
total = lcnt TOvP 1
if or ne n 1 ne total 1
bs 1 TB2a
bu 1 total
bt 1 TB2b
bu 1 n
bt 1 TB2c
row 2 false
bs 1 TB3n
row 3 false
if eq kind 1
bs 1 TB4n
row 4 false
end
bs 1 TB5n
row 5 false
put J 0 1
ret false
end
ret true
end

fn judge2 kind ulong to void
before = get NV 0
okb = get NV 1
with = get NV 2
ownb = get NV 3
opc = get NV 6
by = get NV 7
if eq kind 0
okb = before
with = get NV 1
ownb = get NV 2
by = get NV 3
opc = long 0
put NV 4 0
end
put NV 1 okb
put NV 2 with
put NV 3 ownb
ownok = eq ownb 12288
if eq kind 1
ownok = and ge ownb 12288 le ownb 12352
end
ownok = and ownok gt before 0
ownok = and ownok gt with 0
ownok = and ownok eq opc sub okb before
ownok = and ownok eq by sub sub with before ownb
if ownok
bs 1 TB2r
bl 1 before
bt 1 TSl
bl 1 okb
bt 1 TSl
bl 1 with
bt 1 TB2own
bl 1 ownb
bt 1 TB2op
bl 1 opc
bt 1 TB2by
bl 1 by
bt 1 TB2ok
row 2 true
else
bs 1 TB2f1
bl 1 opc
bt 1 TB2f2
bl 1 by
bt 1 TB2f3
bl 1 ownb
bt 1 TB2f4
row 2 false
end
put J 1 1
put J 2 opc
put J 3 1
put J 4 by
end

fn judge3 to void
x = fload 25
lvals TPid 10
lvals TVm 11
lvals TDrv 12
x = fload 24
lhold 13
with = get NV 2
vm = bnum 11
ok = false
if and and gt get Bn 13 0 beq 13 10 ge vm 0
d = sub vm with
if lt d 0
d = neg d
end
ok = le d 4096
end
if ok
bs 1 TB3a
bb 1 10
bt 1 TB3b
bb 1 11
bt 1 TB3c
bl 1 with
bt 1 TB3d
row 3 true
else
bs 1 TB3f1
bb 1 13
bt 1 TB3f2
bb 1 10
bt 1 TB3f3
bb 1 11
bt 1 TB3f4
bl 1 with
row 3 false
end
end

fn judge45 kind ulong to void
opc = get J 2
rss = get J 4
if gt opc rss
rss = opc
end
if lt rss 0
rss = long 0
end
drv = bnum 12
dp = long 0
if eq kind 1
if ge drv 0
bs 1 TB4a
bb 1 10
bt 1 TB4b
bb 1 12
bt 1 TB4c
bl 1 get NV 4
bt 1 TB4d
row 4 true
dp = sub mul drv 1024 get NV 3
if lt dp 0
dp = long 0
end
else
bs 1 TB4f1
bb 1 10
bt 1 TB4f2
bb 1 12
bt 1 TB4f3
row 4 false
end
end
tax = add rss dp
put J 5 1
put J 6 tax
if and eq kind 1 lt drv 0
bs 1 TB5a
bl 1 rss
bt 1 TB4d
row 5 false
else
bs 1 TB5b
bl 1 tax
bt 1 TB5c
bl 1 rss
bt 1 TB5d
bl 1 dp
bt 1 TB5e
row 5 le tax 262144
end
end

fn judge kind ulong nm view uchar * to void
for i ulong 8
put J i 0
end
bclr 14
bpath 24 nm TLog
bpath 25 nm TOut
if not judge12 kind
ret
end
judge2 kind
judge3
judge45 kind
if eq get J 7 0
put J 0 0
else
put J 0 1
end
end

fn bverd r ulong v long to void
if eq v 0
bt r TPASS
end
if eq v 1
bt r TFAIL
end
if eq v 2
bt r TNR
end
end

fn bkind r ulong kind ulong to void
if eq kind 1
bt r TGpuK
else
bt r TSim
end
end

fn bbars r ulong mask long to void
for b ulong 6
if ne and mask long shl ulong 1 b 0
bt r TBar1
bu r b
end
end
end

note expect: want 0 PASS, 1 FAIL, 2 NOT_RUN; a FAIL expectation names the bars (bit b) that must be among the failed
fn expect nm view uchar * kind ulong want long mask long to void
bs 2 nm
bt 2 TEx1
bkind 2 kind
bt 2 TEx2
bverd 2 want
if ne mask 0
bt 2 TEx3
bbars 2 mask
end
bt 2 TEx4
bout 1 2
judge kind nm
v = get J 0
bs 2 TArr
bverd 2 v
if and eq v want eq and get J 7 mask mask
bt 2 TAsEx
else
if gt get Bn 14 0
bt 2 TFl
bb 2 14
bt 2 TPar
end
bt 2 TNot
bverd 2 want
if ne mask 0
bt 2 TEx3
bbars 2 mask
end
bt 2 TNL
put E 0 add get E 0 1
end
bout 1 2
end

fn notrun t view uchar * to void
bs 2 TNRc
bt 2 t
bt 2 TNL
bout 1 2
exit 2
end

note ---- check-gpu
fn checkgpu to int
bpath 24 TNMain TLog
if not bexists 24
bs 2 TNRc
bt 2 TNoMain
bb 2 4
bt 2 TNoMain2
bt 2 TNL
bout 1 2
ret 2
end
put E 0 0
say TMainH
judge 1 TNMain
mv = get J 0
tset = get J 5
tax = get J 6
bs 2 TArr
bverd 2 mv
bt 2 TNL
bout 1 2
if eq mv 2
say TMainNR
ret 2
end
expect TNShort 1 1 2
expect TNBal 1 1 32
if and eq get J 1 1 ge get J 2 524288
bs 2 TBalG
bl 2 get J 2
bt 2 TBalS2
else
bs 2 TBalGN
if eq get J 1 1
bl 2 get J 2
end
bt 2 TBalGN2
put E 0 add get E 0 1
end
bout 1 2
if and eq mv 0 eq get E 0 0
bs 2 TTaxP
bl 2 tax
bt 2 TTaxP2
bout 1 2
ret 0
end
bs 2 TTaxF
bverd 2 mv
if eq tset 1
bt 2 TTaxF2
bl 2 tax
bt 2 TTaxF3
end
bt 2 TTaxF4
bu 2 get E 0
bt 2 TTaxF5
bout 1 2
ret 1
end

note ---- measure: runs AL and reads it from outside during its hold. kind 1 gpu. Writes NAME.log and NAME.outside.
note The driver's report for the pid, field 2 of nvidia-smi's "pid, used_memory" rows, into region 12.
fn smiread pid long to void
bclr 12
x = pipefds PF 0 8 524288
if ne x 0
ret
end
rfd = int or long get PF 0 shl long get PF 1 8
wfd = int or long get PF 4 shl long get PF 5 8
alclr
alb 17
alt TSmiQ
alt TSmiF
c = spawn 2 0 wfd
x = fclose wfd
n = ulong 0
while lt n len L bound 999999
k = read rfd L n sub len L n
if le k 0
break
end
n = add n ulong k
end
x = fclose rfd
w = reap c 0
put Ln 0 n
bclr 20
bu 20 ulong pid
p = ulong 0
while lt p n bound 999999
e = lend p
q = p
while lt q e bound 4096
if eq get L q 44
break
end
q = add q 1
end
bclr 3
lcopy p q 3
if lt q e
if beq 3 20
q = add q 1
while lt q e bound 4096
if ne get L q 32
break
end
q = add q 1
end
s = q
while lt q e bound 4096
if eq get L q 44
break
end
q = add q 1
end
lcopy s q 12
ret
end
end
p = add e 1
end
end

note VmRSS of /proc/PID/status (sed 's/^VmRSS:[[:space:]]*\([0-9]*\) kB$/\1/p') into region 11
fn vmread pid long to void
bs 30 TProc
bu 30 ulong pid
bt 30 TStat
bclr 11
if not fload 30
ret
end
p = ulong 0
while lt p get Ln 0 bound 999999
e = lend p
if lpre p e TVmP
q = add p len TVmP
while lt q e bound 4096
c = get L q
if and ne c 32 ne c 9
break
end
q = add q 1
end
s = q
while lt q e bound 4096
c = get L q
if or lt c 48 gt c 57
break
end
q = add q 1
end
if leq q e TkB
lcopy s q 11
end
end
p = add e 1
end
end

fn holdseen to bool
x = fload 24
ret gt lcnt THold 1 0
end

fn measure nm view uchar * kind ulong to void
bpath 24 nm TLog
bpath 25 nm TOut
bs 26 TCmd
bcmd 26
bt 26 TNL
bt 26 TUs
bstamp 26 0
bt 26 TNL
bfile 24 26 578
pid = spawn 1 24 0
rc = neg long 1
for i ulong 600
if holdseen
break
end
rc = reap pid 1
if ge rc 0
break
end
x = sleepns 100000000
end
bs 11 TMiss
bs 12 TMiss
if holdseen
if lt rc 0
rc = reap pid 1
end
end
if holdseen
if lt rc 0
vmread pid
if eq get Bn 11 0
bs 11 TMiss
end
if eq kind 1
for t ulong 3
smiread pid
if gt get Bn 12 0
break
end
bs 12 TMiss
x = sleepns 300000000
end
end
end
end
if lt rc 0
rc = reap pid 0
end
bs 26 TEx
bl 26 rc
bt 26 TNL
bt 26 TUe
bstamp 26 0
bt 26 TNL
bfile 24 26 1089
bs 26 TPid
bl 26 pid
bt 26 TNL
bt 26 TVm
bb 26 11
bt 26 TNL
bt 26 TDrv
bb 26 12
bt 26 TNL
bfile 25 26 578
bs 2 TRan
bt 2 nm
bt 2 TRanE
bl 2 rc
bt 2 TRanV
bb 2 11
bt 2 TRanK
if eq kind 1
bt 2 TRanD
bb 2 12
bt 2 TRanM
end
bt 2 TNL
bout 1 2
end

note ---- dry run
note any /dev entry named nvidia* (compgen -G '/dev/nvidia*')
fn devvis to bool
fd = fopen TDevD 0 len TDevD 0 0
if lt fd 0
ret false
end
seen = false
while true bound 4096
n = getdnts int fd DE 0 len DE
if le n 0
break
end
p = ulong 0
while lt p ulong n bound 8192
rl = add ulong get DE add p 16 shl ulong get DE add p 17 8
ok = true
for i ulong len TNvPre
if ne get DE add add p 19 i get TNvPre i
ok = false
end
end
if ok
seen = true
end
if eq rl 0
break
end
p = add p rl
end
end
x = fclose int fd
ret seen
end

fn cores to bool
if envget TCoreV 16
ret gt get Bn 16 0
end
bs 16 TCoreD
ret true
end

fn alpin to void
alt TNice
alt TN
alt T10
if cores
alt TTask
alt TC
alb 16
end
end

note a hello run that must refuse with exit 2 (the hold bound, the ballast flag outside the control build)
fn refuse nm view uchar * arg view uchar * to void
alclr
alb 6
alt TSimA
alt arg
bpath 24 nm TLog
bs 26 TCmd
bcmd 26
bt 26 TNL
bfile 24 26 578
rc = runwait 1 24
bs 2 nm
bt 2 TCol
bt 2 TGateH
bt 2 arg
bt 2 TGateA
bl 2 rc
if eq rc 2
bt 2 TAsEx
else
bt 2 TGateE
put E 0 add get E 0 1
end
bout 1 2
end

note synthetic GPU logs for the judge's self-test. line 0 none, 1 good, 2 bad sum, 3 two lines, 4 ballast
fn synlog p ulong line ulong bad bool rc view uchar * to void
bs 26 TSyn1
if eq line 1
bt 26 TGood
bt 26 TNL
end
if eq line 2
bt 26 TBadS
bt 26 TNL
end
if eq line 3
bt 26 TGood
bt 26 TNL
bt 26 TGood
bt 26 TNL
end
if eq line 4
bt 26 TBall
bt 26 TNL
end
bt 26 TSyn2
if bad
bt 26 TSynBad
else
bt 26 TSynOk
end
bt 26 TEx
bt 26 rc
bt 26 TNL
bfile p 26 578
end

fn synout p ulong vm view uchar * drv view uchar * to void
bs 26 TSynO1
bt 26 vm
bt 26 TSynO2
bt 26 drv
bt 26 TNL
bfile p 26 578
end

note drv 0 "40", 1 missing, 2 "5000"; rc 0, 1 or 2
fn syn nm view uchar * line ulong drv ulong rc ulong to void
bpath 24 nm TLog
if eq rc 0
synlog 24 line false T0
end
if eq rc 1
synlog 24 line false T1
end
if eq rc 2
synlog 24 line false T2
end
bpath 25 nm TOut
if eq drv 0
synout 25 T15310 T40
end
if eq drv 1
synout 25 T15310 TMiss
end
if eq drv 2
synout 25 T15310 T5000
end
end

note check-gpu on OUTDIR/syn-window in a child, stdout to the verdict file; the exit code
fn verdict vf view uchar * to long
bclr 27
bb 27 4
bt 27 TSynW
bt 27 vf
pid = fork
if lt pid 0
bfail
end
if eq pid 0
f = bopen 27 578
if lt f 0
exit 90
end
x = dupfd int f 1 0
bt 4 TSynW
exit checkgpu
end
ret reap pid 0
end

fn vline t view uchar * rc long want long to void
bs 2 t
bl 2 rc
if eq rc want
bt 2 TAsEx
else
bt 2 TVNot
bl 2 want
bt 2 TNL
put E 0 add get E 0 1
end
bout 1 2
end

note path region 30 = OUTDIR/syn-window/ nm sx
fn swpath nm view uchar * sx view uchar * to void
bclr 30
bb 30 4
bt 30 TSynW
bt 30 TSl
bt 30 nm
bt 30 sx
end

fn selftest to void
say TSynHd
syn TSynG 1 0 0
syn TSynND 1 1 0
syn TSynDT 1 2 0
syn TSynBS 2 0 0
syn TSynTL 3 0 0
syn TSynNL 0 0 0
syn TSynE1 1 0 1
syn TSynNDv 0 1 2
expect TSynG 1 0 0
expect TSynND 1 1 48
expect TSynDT 1 1 32
expect TSynBS 1 1 4
expect TSynTL 1 1 4
expect TSynNL 1 1 4
expect TSynE1 1 1 2
expect TSynNDv 1 2 0
say TVerHd
bclr 30
bb 30 4
bt 30 TSynW
x = makedir B mul ulong 30 4096 get Bn 30 493
swpath TNMain TLog
synlog 30 1 false T0
swpath TNMain TOut
synout 30 T15310 T40
swpath TNShort TOut
synout 30 T15310 T40
swpath TNShort TLog
synlog 30 1 true T1
swpath TNBal TLog
synlog 30 4 false T0
swpath TNBal TOut
synout 30 T539610 T40
vline TVGood verdict TVer 0
swpath TNBal TLog
synlog 30 1 false T0
swpath TNBal TOut
synout 30 T15310 T40
vline TVBlind verdict TVerB 1
end

fn dryrun hidden bool to int
if not hidden
if devvis
if ne faccess TBwrap 0 len TBwrap 1 0
notrun TNoBw
end
alclr
alpin
alt TBwrap
alt TDevB
alt TSl
alt TSl
alt TDev
alt TDevD
alt TProcA
alt TProcD
alt TDDash
alb 5
alt TMHid
alb 4
alb 6
alb 7
put AL 0 uchar get AP 1
put AL 1 0
x = execprog AL 0 get AP 0
bfail
end
end
if devvis
notrun TDevVis
end
mkdirp 4
alclr
alb 6
alt TSimA
alt TH1000
measure TSMain 0
alclr
alb 7
alt TSimA
alt TShort
alt TH1000
measure TSShort 0
alclr
alb 7
alt TSimA
alt TBal512
alt TH1000
measure TSBal 0
alclr
alb 6
alt TH1000
measure THid 1
put E 0 0
expect TSMain 0 0 0
expect TSShort 0 1 2
expect TSBal 0 1 32
if and eq get J 3 1 ge get J 4 524288
bs 2 TBalS
bl 2 get J 4
bt 2 TBalS2
else
bs 2 TBalN
if eq get J 3 1
bl 2 get J 4
end
bt 2 TBalN2
put E 0 add get E 0 1
end
bout 1 2
expect THid 1 2 0
refuse TBound TH60001
refuse TBGate TBal64
selftest
if eq get E 0 0
say TDryP
ret 0
end
bs 2 TDryF
bu 2 get E 0
bt 2 TDryF2
bout 1 2
ret 1
end

