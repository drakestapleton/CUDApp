note SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
note HOST-ONLY queue model. Anonymous mappings, no device words. nvsend parses the actual packet.
global nverr long 1
global nvfault uchar 1
global nvstage uint 1
global bfstat ulong 4
note bfstat: kicks waits sleeps last sleep. bffail is 1-based simulated failing kernel, 0 none.
global bffail ulong 1
note bfcache: GPU-cache flag per nvalloc call, in call order (1 cached, 2 uncached).
global bfcache uchar 16
global bfallocs ulong 1
fn nvfull to bool
ret true
end
fn nvchan to bool
ret true
end
fn nvalloc want ulong cached bool to long
k = get bfallocs 0
if lt k 16
put bfcache k uchar 2
if cached
put bfcache k uchar 1
end
end
put bfallocs 0 add k 1
ret mapnew -1 0 want 3 34
end
fn nvsend m long off ulong words uint to bool
put bfstat 0 add get bfstat 0 1
ret bfdev m off words
end
fn nvwait m long off ulong value uint budget ulong to bool
put bfstat 1 add get bfstat 1 1
for i ulong 4
if eq mapget m off 4 ulong value
ret true
end
put bfstat 2 add get bfstat 2 1
put bfstat 3 100000
s = sleepns 100000
end
put nverr 0 -110
put nvfault 0 1
ret false
end
