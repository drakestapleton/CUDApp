note Concatenate after tests/components/proc.om. Run from repository root.
text NgAbiNo "NOT_RUN abi comparison (nvml.h absent; set CUDA_NVML_INCLUDE)\n"
text NgAbiOk "PASS shell compiles against the CUDA nvml.h prototypes\n"
text NgThinOk "PASS thin-shell guard\nPASS thin-shell guard negative control\n"
text NgNameN "nvml"
text NgNameQ "query"
text NgNameE "errstr"
text NgFailP "CUDAPP-NVML HOST FAIL ("
text NgMpass "mutants caught 22/22\n"
text NgBuild "build"
text NgComm "PASS committed "
text NgBridge " is the bridge output of native/nvml\n"
text NgFakeP "PASS fake tier: "
text NgPure "PASS seeded Omega fake tier: "
text NgNegP "PASS oracle negative control (altered string rejected: "
text NgCloseP ")\n"
text NgMutP "  mutant "
text NgQuote " '"
text NgCaught "': caught ("
text NgAbiP "PASS abi: "
text NgFacts " facts equal to "
note Existing bridge shell and C ABI caller are MIGRATION dependencies, not Omega implementations.
text NgDir "build/nvml"
text NgSrc "build/nvml/unit.om"
text NgBin "build/nvml/host"
text NgOut "build/nvml/out"
text NgHash "build/nvml/hash"
text NgOld "build/nvml/caller"
text NgFake "build/nvml/fake.c"
text NgBad "build/nvml/bad.tsv"
text NgOrac "tests/nvml/errstr-oracle.tsv"
text NgPass "CUDAPP-NVML HOST PASS (476 checks)\n"
text NgFail "CUDAPP-NVML HOST FAIL (1 of 476 checks)\n"
text NgPin "2c82480596bbdc50cda9626866209ef662d5834f278f839ff4ce0250c495029f"
text NgPref "FRONTEND_PIN="
text NgUnits "om/units.sh"
text NgWrap "/tools/bridge-seeded"
text NgEnv "/usr/bin/env"
text NgPath "PATH=/usr/bin:/bin"
text NgSeed "OMEGA_SEEDED_OMC="
text NgSh "/bin/sh"
text NgSha "/usr/bin/sha256sum"
text NgCc "/usr/bin/cc"
text NgC "c"
text NgH "h"
text NgCout "build/nvml/unit.c"
text NgHout "build/nvml/unit.h"
text NgHdr "src/cudapp_native.h"
text NgStep "src/cudapp_om_nvml_step.c"
text NgErr "src/cudapp_om_nvml_errstr.c"
text NgN "native/nvml/nvml.om"
text NgQ "native/nvml/query.om"
text NgS "native/nvml/step.om"
text NgE "native/nvml/errstr.om"
text NgF "tests/nvml/rmfake.om"
text NgHost "tests/nvml/host.om"
text NgShell "compat/nvml/cudapp_nvml.c"
text NgFat "static int x(void) { return ioctl(3, 0x20800110); }\n"
text NgOk "CUDAPP-NVML HOST PASS\n"
text NgNo "NOT_RUN: set OMEGA_OMC (omega-mv e5b32567 omc) and OMEGA_BRIDGE (omega-bridge checkout)\n"
text NgRp "REFUSED: no FRONTEND_PIN in om/units.sh\n"
text NgRo "REFUSED: omc digest is not the omega-mv e5b32567 pin\n"
text NgRb "REFUSED: bridge-seeded digest is not the om/units.sh frontend pin\n"
text NgOmEnv "OMEGA_OMC="
text NgBrEnv "OMEGA_BRIDGE="
text NgCudaE "CUDA_NVML_INCLUDE="
text NgCuda "/usr/local/cuda/include"
text NgNvH "/nvml.h"
