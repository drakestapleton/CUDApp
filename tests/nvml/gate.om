fn ng_env key view uchar * dst edit uchar * to ulong
b = new uchar 8192 0
for i ulong ulong envcnt
r = envread i b 0 len b
if ge r long len key
if hp_equal key b len key
n = sub ulong r len key
hp_require le n len dst
for j ulong n
put dst j get b add len key j
end
ret n
end
end
end
ret 0
end

fn ng_exec path view uchar * code long to void
fd = hp_open path len path 524865 420
hp_exec -1 fd code
hp_close fd
end

fn ng_hash path view uchar * n ulong dst edit uchar 64 to void
b = new uchar 2048 0
hp_start NgSha len NgSha
hp_arg path n
ng_exec NgHash 0
k = hp_read NgHash len NgHash b len b
hp_require ge k 64
for i ulong 64
put dst i get b i
end
end

fn ng_config to void
b = new uchar 1024 0
c = new uchar 1024 0
hash = new uchar 64 0
pin = new uchar 64 0
on = ng_env NgOmEnv b
bn = ng_env NgBrEnv c
if or eq on 0 eq bn 0
hp_say NgNo
exit 77
end
if ne faccess b 0 on 1 0
hp_say NgNo
exit 77
end
hp_require le add bn len NgWrap len c
for i ulong len NgWrap
put c add bn i get NgWrap i
end
bn = add bn len NgWrap
if ne faccess c 0 bn 4 0
hp_say NgNo
exit 77
end
put HOn 0 on
for i ulong on
put HOm i get b i
end
put NgBn 0 bn
for i ulong bn
put NgBr i get c i
end
ng_hash b on hash
if not hp_equal hash NgPin 64
hp_say NgRo
exit 69
end
ng_pin pin
ng_hash c bn hash
if not hp_equal hash pin 64
hp_say NgRb
exit 69
end
ng_cabi
n = ng_env NgCudaE b
if eq n 0
n = len NgCuda
for i ulong n
put b i get NgCuda i
end
end
put NgCn 0 n
for i ulong n
put NgCu i get b i
end
end

fn ng_pin pin edit uchar 64 to void
ng_pinin NgUnits NgPref 0 pin
end

note refuse 0: om/units.sh FRONTEND_PIN; refuse 1: om/omega-bridge-cabi.lock CABI rows.
fn ng_pinin path view uchar * prefix view uchar * refuse ulong pin edit uchar 64 to void
rows = new uchar 65536 0
n = hp_read path len path rows len rows
hits = ulong 0
for p ulong n
if ng_line rows p
if le add p add len prefix 65 n
if ng_at rows p prefix
if ng_pinrow rows add p len prefix pin
hits = add hits 1
end
end
end
end
end
if ne hits 1
if eq refuse 0
hp_say NgRp
else
hp_say NgRcl
end
exit 74
end
end

note The #83 converter is used only for native/nvml/api.om; both of its files are pinned by digest.
fn ng_cabi to void
c = new uchar 1024 0
w = new uchar 1024 0
t = new uchar 1024 0
hash = new uchar 64 0
pin = new uchar 64 0
k = ng_env NgCabE c
if eq k 0
hp_say NgCabNo
exit 77
end
wn = ng_join c k NgWrap w
tn = ng_join c k NgToc t
if ne faccess w 0 wn 4 0
hp_say NgCabNo
exit 77
end
if ne faccess t 0 tn 4 0
hp_say NgCabNo
exit 77
end
put NgKn 0 wn
for i ulong wn
put NgKr i get w i
end
ng_pinin NgLock NgCpinP 1 pin
ng_hash t tn hash
if not hp_equal hash pin 64
hp_say NgRct
exit 69
end
ng_pinin NgLock NgFpinP 1 pin
ng_hash w wn hash
if not hp_equal hash pin 64
hp_say NgRcf
exit 69
end
hp_wpart 1 NgCabOk 0 len NgCabOk
end

fn ng_join c view uchar * k ulong suffix view uchar * dst edit uchar 1024 to ulong
hp_require le add k len suffix len dst
for i ulong k
put dst i get c i
end
for i ulong len suffix
put dst add k i get suffix i
end
ret add k len suffix
end

fn ng_put dst edit uchar 65536 k ulong src view uchar * off ulong n ulong to ulong
hp_require le add k n len dst
for i ulong n
put dst add k i get src add off i
end
ret add k n
end

fn ng_need ok bool label view uchar * to void
if not ok
hp_wpart 2 NgFailP 0 len NgFailP
hp_wpart 2 label 0 len label
exit 1
end
end

fn ng_line b view uchar * p ulong to bool
if eq p 0
ret true
end
ret eq get b sub p 1 10
end

fn ng_pinrow b view uchar * p ulong dst edit uchar 64 to bool
for j ulong 64
v = get b add p j
if not ng_hex v
ret false
end
put dst j v
end
ret eq get b add p 64 10
end

fn ng_hex v uchar to bool
if and ge v 48 le v 57
ret true
end
ret and ge v 97 le v 102
end

fn ng_at buf view uchar * pos ulong word view uchar * to bool
if gt len word sub len buf pos
ret false
end
for i ulong len word
if ne get buf add pos i get word i
ret false
end
end
ret true
end

fn ng_has buf view uchar * used ulong word view uchar * to bool
for p ulong used
if le add p len word used
if ng_at buf p word
ret true
end
end
end
ret false
end

fn ng_cat path view uchar * to void
hp_cat path len path
p = get HUsed 0
hp_require lt p len HSrc
put HSrc p 10
put HUsed 0 add p 1
end

fn ng_save to void
fd = hp_open NgSrc len NgSrc 524865 420
hp_src fd
hp_close fd
end

fn ng_build to void
ng_save
infd = hp_open NgSrc len NgSrc 524288 0
outfd = hp_open NgBin len NgBin 524865 493
hp_tool 0
hp_exec infd outfd 0
hp_close infd
hp_close outfd
hp_require eq chmod NgBin 0 len NgBin 493 0
end

fn ng_comp to void
put HUsed 0 0
ng_cat NgN
ng_cat NgQ
ng_cat NgS
ng_cat NgE
ng_cat NgF
ng_cat NgHost
end

fn ng_bridge mode view uchar * source view uchar * dest view uchar * to void
put NgWhich 0 0
ng_bridgew mode source dest
end

fn ng_bridgek mode view uchar * source view uchar * dest view uchar * to void
put NgWhich 0 1
ng_bridgew mode source dest
put NgWhich 0 0
end

note NgWhich 0: OMEGA_BRIDGE (om/units.sh pin); 1: OMEGA_CABI_BRIDGE (om/omega-bridge-cabi.lock pins).
fn ng_wrapc w edit uchar 2048 to ulong
if eq get NgWhich 0 1
for i ulong get NgKn 0
put w i get NgKr i
end
ret get NgKn 0
end
for i ulong get NgBn 0
put w i get NgBr i
end
ret get NgBn 0
end

fn ng_bridgew mode view uchar * source view uchar * dest view uchar * to void
b = new uchar 2048 0
hp_start NgEnv len NgEnv
hp_arg NgPath len NgPath
for i ulong len NgSeed
put b i get NgSeed i
end
for i ulong get HOn 0
put b add len NgSeed i get HOm i
end
hp_arg b add len NgSeed get HOn 0
hp_arg NgSh len NgSh
n = ng_wrapc b
hp_arg b n
hp_arg mode len mode
hp_arg source len source
ng_exec dest 0
end

fn ng_same gen view uchar * kept view uchar * to void
if not hp_cmp gen len gen kept len kept
hp_wpart 2 NgDiff 0 len NgDiff
hp_wpart 2 kept 0 len kept
hp_wpart 2 NgCloseP 0 len NgCloseP
exit 1
end
end

fn ng_lib to void
ng_bridgek NgLc NgApi NgLibC
ng_same NgLibC NgCLib
ng_bridgek NgLh NgApi NgLibH
ng_same NgLibH NgCH
ng_bridgek NgLm NgApi NgLibM
ng_same NgLibM NgCMap
hp_wpart 1 NgLibOk 0 len NgLibOk
ng_cc
hp_arg NgPic len NgPic
hp_arg NgShared len NgShared
hp_arg NgIsrc len NgIsrc
hp_arg NgIcmp len NgIcmp
hp_arg NgSoname len NgSoname
hp_arg NgVers len NgVers
hp_arg NgDashO len NgDashO
hp_arg NgSo len NgSo
hp_arg NgCLib len NgCLib
hp_arg NgStep len NgStep
hp_arg NgErr len NgErr
hp_arg NgPth len NgPth
hp_exec -1 -1 0
end

fn ng_binding saved view uchar * to void
proto = new uchar 4096 0
header = new uchar 65536 0
ng_save
ng_bridge NgC NgSrc NgCout
hp_require hp_cmp NgCout len NgCout saved len saved
ng_bridge NgH NgSrc NgHout
n = hp_read NgHout len NgHout proto len proto
k = hp_read NgHdr len NgHdr header len header
hp_require gt n 0
hp_require ng_hasn header k proto n
hp_wpart 1 NgComm 0 len NgComm
hp_wpart 1 saved 0 len saved
hp_wpart 1 NgBridge 0 len NgBridge
end

fn ng_cc to void
hp_start NgEnv len NgEnv
hp_arg NgPath len NgPath
hp_arg NgCc len NgCc
hp_arg NgStd len NgStd
hp_arg NgOpt len NgOpt
hp_arg NgWall len NgWall
hp_arg NgExtra len NgExtra
hp_arg NgWerr len NgWerr
end

fn ng_caller to void
ng_bridge NgC NgF NgFake
ng_cc
hp_arg NgIsrc len NgIsrc
hp_arg NgIcmp len NgIcmp
hp_arg NgItst len NgItst
hp_arg NgRdyn len NgRdyn
hp_arg NgDashO len NgDashO
hp_arg NgOld len NgOld
hp_arg NgTest len NgTest
hp_arg NgTrans len NgTrans
hp_arg NgFake len NgFake
hp_arg NgSo len NgSo
hp_arg NgRpath len NgRpath
hp_arg NgPth len NgPth
hp_exec -1 -1 0
hp_start NgOld len NgOld
hp_arg NgOrac len NgOrac
ng_exec NgOut 0
ng_result NgPass
hp_wpart 1 NgLibP 0 len NgLibP
hp_wpart 1 NgPass 0 len NgPass
end

fn ng_result expected view uchar * to void
b = new uchar 65536 0
n = hp_read NgOut len NgOut b len b
hp_require ge n len expected
hp_require ng_at b sub n len expected expected
end

fn ng_run oracle view uchar * code long to void
hp_start NgBin len NgBin
hp_arg oracle len oracle
ng_exec NgOut code
end

fn ng_oracle to void
b = new uchar 65536 0
dst = new uchar 65536 0
n = hp_read NgOrac len NgOrac b len b
line = ulong 0
p = ulong 0
while lt p n bound 65536
if eq get b p 10
line = add line 1
end
put dst p get b p
p = add p 1
if and eq line 1 eq get b sub p 1 9
break
end
end
hp_require lt p n
k = p
for i ulong len NgSucc
put dst k get NgSucc i
k = add k 1
end
while lt p n bound 65536
if eq get b p 10
break
end
p = add p 1
end
while lt p n bound 65536
put dst k get b p
k = add k 1
p = add p 1
end
hp_write NgBad len NgBad dst k
hp_require not hp_cmp NgBad len NgBad NgOrac len NgOrac
ng_run NgBad 1
ng_result NgFail
hp_wpart 1 NgNegP 0 len NgNegP
hp_wpart 1 NgFail 0 sub len NgFail 1
hp_wpart 1 NgCloseP 0 len NgCloseP
end

fn ng_abi to void
b = new uchar 2048 0
for i ulong get NgCn 0
put b i get NgCu i
end
n = get NgCn 0
for i ulong len NgNvH
put b add n i get NgNvH i
end
if ne faccess b 0 add n len NgNvH 4 0
hp_say NgAbiNo
ret
end
ng_cc
hp_arg NgIcmp len NgIcmp
hp_arg NgAbi len NgAbi
hp_arg NgDashO len NgDashO
hp_arg NgAO len NgAO
hp_exec -1 -1 0
hp_start NgAO len NgAO
ng_exec NgAT 0
ng_cc
hp_arg NgDashI len NgDashI
hp_arg b n
hp_arg NgAbi len NgAbi
hp_arg NgDashO len NgDashO
hp_arg NgAC len NgAC
hp_exec -1 -1 0
hp_start NgAC len NgAC
ng_exec NgCT 0
hp_require hp_cmp NgAT len NgAT NgCT len NgCT
ng_abimsg b n
ng_proto b n
end

fn ng_proline h view uchar * p ulong q ulong to bool
if lt sub q p 20
ret false
end
if not or ng_at h p NgRetT ng_at h p NgStrT
ret false
end
ret and eq get h sub q 1 59 eq get h sub q 2 41
end

fn ng_syntax inc view uchar * incn ulong file view uchar * code long to void
ng_cc
hp_arg NgSyn len NgSyn
hp_arg NgDashI len NgDashI
hp_arg inc incn
hp_arg file len file
hp_exec -1 -1 code
end

fn ng_subst a view uchar * an ulong dst edit uchar 65536 to ulong
k = ulong 0
hits = ulong 0
p = ulong 0
while lt p an bound 65536
if and le add p len NgGnF an ng_at a p NgGnF
k = ng_put dst k NgGnT 0 len NgGnT
p = add p len NgGnF
hits = add hits 1
else
k = ng_put dst k a p 1
p = add p 1
end
end
ng_need eq hits 1 NgLsub
ret k
end

note The generated header's 11 prototypes, alone after NVIDIA's nvml.h, must compile: any conflicting
note type is a hard error. The negative control changes one parameter type and must be rejected.
fn ng_proto inc view uchar * incn ulong to void
h = new uchar 65536 0
d = new uchar 65536 0
x = new uchar 65536 0
m = hp_read NgCH len NgCH h len h
k = ng_put d 0 NgInc 0 len NgInc
cnt = ulong 0
p = ulong 0
while lt p m bound 65536
q = p
while lt q m bound 65536
if eq get h q 10
break
end
q = add q 1
end
if ng_proline h p q
k = ng_put d k h p sub q p
k = ng_put d k NgNl 0 1
cnt = add cnt 1
end
p = add q 1
end
ng_need eq cnt 11 NgLpro
hp_write NgProto len NgProto d k
ng_syntax inc incn NgProto 0
kx = ng_subst d k x
hp_write NgProtoB len NgProtoB x kx
ng_syntax inc incn NgProtoB 1
hp_wpart 1 NgProOk 0 len NgProOk
end

fn ng_countn b view uchar * n ulong w view uchar * wn ulong to ulong
c = ulong 0
for p ulong n
if le add p wn n
ok = true
for i ulong wn
if ne get b add p i get w i
ok = false
end
end
if ok
c = add c 1
end
end
end
ret c
end

fn ng_sym b view uchar * n ulong sym view uchar * to void
w = new uchar 65536 0
k = ng_put w 0 NgT 0 len NgT
k = ng_put w k sym 0 len sym
k = ng_put w k NgNl 0 1
ng_need eq ng_countn b n w k 1 NgLexp
end

note nm lines are "<addr> <type> <name>[@version]"; each imported name must be in NgAllow.
fn ng_undef path view uchar * dyn bool to bool
b = new uchar 16384 0
w = new uchar 65536 0
hp_start NgNm len NgNm
if dyn
hp_arg NgDynF len NgDynF
end
hp_arg NgUndF len NgUndF
hp_arg path len path
ng_exec NgNuO 0
n = hp_read NgNuO len NgNuO b len b
lines = ulong 0
p = ulong 0
while lt p n bound 16384
q = p
while lt q n bound 16384
if eq get b q 10
break
end
q = add q 1
end
s = p
while lt s q bound 16384
if ne get b s 32
break
end
s = add s 1
end
if ge add s 2 q
ret false
end
en = add s 2
while lt en q bound 16384
if eq get b en 64
break
end
en = add en 1
end
if gt sub en add s 2 250
ret false
end
put w 0 32
k = ng_put w 1 b add s 2 sub en add s 2
put w k 32
if not ng_hasn NgAllow len NgAllow w add k 1
ret false
end
lines = add lines 1
p = add q 1
end
ret gt lines 0
end

fn ng_guard to void
b = new uchar 16384 0
hp_start NgNm len NgNm
hp_arg NgDynF len NgDynF
hp_arg NgDefF len NgDefF
hp_arg NgSo len NgSo
ng_exec NgNmO 0
n = hp_read NgNmO len NgNmO b len b
ng_need eq ng_countn b n NgNl 1 11 NgLexp
ng_sym b n NgX1
ng_sym b n NgX2
ng_sym b n NgX3
ng_sym b n NgX4
ng_sym b n NgX5
ng_sym b n NgX6
ng_sym b n NgX7
ng_sym b n NgX8
ng_sym b n NgX9
ng_sym b n NgX10
ng_sym b n NgX11
hp_start NgRe len NgRe
hp_arg NgDynD len NgDynD
hp_arg NgSo len NgSo
ng_exec NgReO 0
n = hp_read NgReO len NgReO b len b
ng_need ng_has b n NgSonam NgLson
hp_wpart 1 NgExpOk 0 len NgExpOk
ng_need ng_undef NgSo true NgLund
n = hp_read NgNuO len NgNuO b len b
ng_need ng_has b n NgTsym NgLund
hp_write NgFatC len NgFatC NgFat len NgFat
ng_cc
hp_arg NgDashC len NgDashC
hp_arg NgFatC len NgFatC
hp_arg NgDashO len NgDashO
hp_arg NgFatO len NgFatO
hp_exec -1 -1 0
ng_need not ng_undef NgFatO false NgLneg
n = hp_read NgNuO len NgNuO b len b
ng_need ng_has b n NgIoU NgLneg
hp_wpart 1 NgGrdOk 0 len NgGrdOk
end

fn ng_replace from view uchar * into view uchar * to void
b = new uchar 1048576 0
n = get HUsed 0
for i ulong n
put b i get HSrc i
end
put HUsed 0 0
p = ulong 0
hits = ulong 0
while lt p n bound 999999
q = p
while lt q n bound 999999
if eq get b q 10
break
end
q = add q 1
end
if and eq sub q p len from ng_at b p from
hits = add hits 1
ng_append into 0 len into
else
ng_append b p sub q p
end
put HSrc get HUsed 0 10
put HUsed 0 add get HUsed 0 1
p = add q 1
end
hp_require eq hits 1
end

fn ng_append b view uchar * p ulong n ulong to void
hp_require le n sub len HSrc get HUsed 0
for i ulong n
put HSrc get HUsed 0 get b add p i
put HUsed 0 add get HUsed 0 1
end
end

fn ng_mutant unit view uchar * from view uchar * into view uchar * to void
b = new uchar 65536 0
put HUsed 0 0
ng_cat NgN
ng_cat NgQ
ng_cat NgS
ng_cat NgE
ng_replace from into
ng_cat NgF
ng_cat NgHost
ng_build
ng_run NgOrac 1
n = hp_read NgOut len NgOut b len b
hp_require ng_has b n NgFailP
hp_wpart 1 NgMutP 0 len NgMutP
hp_wpart 1 unit 0 len unit
hp_wpart 1 NgQuote 0 len NgQuote
hp_wpart 1 from 0 len from
hp_wpart 1 NgCaught 0 len NgCaught
ng_last b n
hp_wpart 1 NgCloseP 0 len NgCloseP
end

fn ng_last b view uchar * n ulong to void
hp_require gt n 0
p = sub n 1
while gt p 0 bound 65536
if eq get b sub p 1 10
break
end
p = sub p 1
end
hp_wpart 1 b p sub sub n p 1
end

fn ng_abimsg path view uchar * pn ulong to void
b = new uchar 65536 0
digits = new uchar 32 0
n = hp_read NgAT len NgAT b len b
hp_require gt n 0
lines = ulong 0
for i ulong n
if eq get b i 10
lines = add lines 1
end
end
dn = hp_num lines digits
hp_wpart 1 NgAbiP 0 len NgAbiP
hp_wpart 1 digits 0 dn
hp_wpart 1 NgFacts 0 len NgFacts
hp_wpart 1 path 0 pn
hp_wpart 1 NgNvH 0 len NgNvH
hp_wpart 1 NgNl 0 len NgNl
end


fn ng_hasn buf view uchar * used ulong word view uchar * wn ulong to bool
for p ulong used
if le add p wn used
ok = true
for i ulong wn
if ne get buf add p i get word i
ok = false
end
end
if ok
ret true
end
end
end
ret false
end

fn ng_work to int
r = makedir NgBuild 0 len NgBuild 493
hp_require or eq r 0 eq r -17
r = makedir NgDir 0 len NgDir 493
hp_require or eq r 0 eq r -17
ng_config
put HUsed 0 0
ng_cat NgN
ng_cat NgQ
ng_cat NgS
ng_binding NgStep
put HUsed 0 0
ng_cat NgE
ng_binding NgErr
ng_comp
ng_build
ng_run NgOrac 0
ng_result NgPass
hp_wpart 1 NgPure 0 len NgPure
hp_wpart 1 NgPass 0 len NgPass
ng_oracle
ng_lib
ng_caller
ng_abi
ng_guard
ng_mutants
hp_wpart 1 NgOk 0 len NgOk
ret 0
end

note Preserve the former driver's public failure code; internal helper/exec refusals never pass.
fn main to int
st = new uchar 4 0
pid = fork
if lt pid 0
ret 74
end
if eq pid 0
exit ng_work
end
hp_wait pid st
if ne get st 0 0
ret 1
end
rc = int get st 1
if eq rc 0
ret 0
end
if eq rc 77
ret rc
end
if eq rc 69
ret rc
end
if eq rc 74
ret rc
end
ret 1
end
